<mah:MetroWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:workspace="clr-namespace:Inventory_System.viewo_Model"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:child="http://metro.mahapps.com/winfx/xaml/simplechildwindow" 
                 x:Class="Inventory_System.MainWindows.MainWindow"
                 Title="مساحة العمل | حصر المقرات" Width="1380" Height="860" MinWidth="1080" 
                 MinHeight="640" WindowStartupLocation="CenterScreen" WindowState="Maximized"
                 ResizeMode="CanResizeWithGrip" WindowStyle="None" AllowsTransparency="True"
                 ShowTitleBar="False" ShowCloseButton="False" ShowMinButton="False" 
                 ShowMaxRestoreButton="False" Loaded="MetroWindow_Loaded" 
                 Closing="MetroWindow_Closing" PreviewKeyDown="PremisesPreviewKeyDown" 
                 TitleAlignment="Center" BorderThickness="0"
                 Background="Transparent" GlowBrush="{x:Null}" 
                 FlowDirection="RightToLeft" FontFamily="Segoe UI" 
                 xmlns:local="clr-namespace:Inventory_System.MainWindows"
                 FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" 
                 TextOptions.TextFormattingMode="Display"
                 Icon="/Inventory_System;component/Resources/ssf Logo.jpg"
                 x:Name="MainShell" dx:ThemeManager.ThemeName="Win11Light" WindowButtonCommandsOverlayBehavior="Never" 
                 NonActiveGlowBrush="{x:Null}" IgnoreTaskbarOnMaximize="False">
    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/DcmsTheme.xaml"/>
                <ResourceDictionary Source="../Resources/MaintenanceWorkspace.xaml"/>
                <ResourceDictionary Source="../Resources/AccessibleEditors.xaml"/>

            </ResourceDictionary.MergedDictionaries>
            <!-- بالون صغير يتمدد رأسيًا بحسب طول الرسالة. -->
            <Style x:Key="Maintenance.ToastStyle" TargetType="ContentControl">
                <Setter Property="Width" Value="350"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <DataTemplate x:Key="Maintenance.Toast">
                <Border Width="350" Background="{Binding TintColor}" BorderBrush="{Binding AccentColor}" BorderThickness="1" CornerRadius="10" Padding="12" FlowDirection="RightToLeft">
                    <StackPanel>
                        <DockPanel>
                            <icons:PackIconMaterial Kind="BellRingOutline" Width="19" Height="19" Foreground="{Binding AccentColor}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Title}" FontSize="15" Foreground="{Binding AccentColor}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Text}" FontSize="13" Foreground="#405778" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding ActionHint}" Foreground="{Binding AccentColor}" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <Style x:Key="Workspace.Secondary" TargetType="dx:SimpleButton" BasedOn="{StaticResource Dcms.SecondaryButton}">
                <Setter Property="Background" Value="{StaticResource Workspace.Tint}"/>
                <Setter Property="Foreground" Value="{StaticResource Workspace.Primary}"/>
            </Style>
            <!-- بطاقة أمر مستقلة بحد واضح، وتفاعل بالفأرة ولوحة المفاتيح دون تغيير أمرها أو صلاحيتها. -->
            <Style x:Key="Workspace.Tile" TargetType="dx:SimpleButton" BasedOn="{StaticResource Dcms.QuickTile}">
                <Setter Property="MinHeight" Value="46"/>
                <Setter Property="Margin" Value="5,4"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource Workspace.Ink}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="dx:SimpleButton">
                            <Border x:Name="TileSurface" Background="{TemplateBinding Background}" BorderBrush="#DBE2EE" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TileSurface" Property="Background" Value="#F4F7FD"/>
                                    <Setter TargetName="TileSurface" Property="BorderBrush" Value="#A8BAD5"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="TileSurface" Property="BorderBrush" Value="#9C763A"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="TileSurface" Property="Background" Value="#E8EFF9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.42"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Workspace.Ribbon" TargetType="dx:SimpleButton" BasedOn="{StaticResource Dcms.RibbonButton}">
                <Setter Property="Height" Value="78"/>
                <Setter Property="MinHeight" Value="78"/>
                <Setter Property="Foreground" Value="{StaticResource Workspace.Primary}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Workspace.Tint}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>

    </mah:MetroWindow.Resources>
    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl>
            <!-- تتحرك اللوحة من الأسفل وتتمركز البطاقة داخل المساحة المرئية للحاوية. -->
            <mah:Flyout x:Name="PremisesFlyout" Style="{StaticResource Maintenance.Flyout}"
                        Width="Auto" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type mah:FlyoutsControl}}}">
                <Border Style="{StaticResource Maintenance.Flyout.Card}" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Width="980">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource Workspace.Header}" CornerRadius="17,17,0,0" Padding="18,10">
                            <DockPanel>
                                <dx:SimpleButton x:Name="ClosePremisesFlyoutButton" DockPanel.Dock="Right" Click="ClosePremisesFlyout_Click"
                                                 Style="{StaticResource Dcms.WindowButton}" ToolTip="إغلاق الحصر" AutomationProperties.Name="إغلاق الحصر">
                                    <icons:PackIconMaterial Kind="Close" Width="18" Height="18"/>
                                </dx:SimpleButton>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <icons:PackIconMaterial Kind="OfficeBuildingOutline" Foreground="{StaticResource Maintenance.Flyout.HeaderIcon}"
                                                            Width="28" Height="28" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PremisesFlyoutTitle" Foreground="White" FontSize="23" FontWeight="SemiBold" Margin="10,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="500" Padding="16">
                            <ItemsControl x:Name="PremisesChoices">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <dx:SimpleButton Click="PremisesCard_Click" IsEnabled="{Binding IsEnabled}"
                                                         Style="{StaticResource Workspace.Tile}" MinHeight="68"
                                                         AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Description}" ToolTipService.ShowOnDisabled="True">
                                            <StackPanel Orientation="Horizontal">
                                                <icons:PackIconMaterial Kind="{Binding Icon}" Width="27" Height="27" Margin="0,0,12,0"
                                                                        VerticalAlignment="Center" Foreground="{StaticResource Workspace.Primary}"/>
                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </dx:SimpleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </mah:Flyout>
        </mah:FlyoutsControl>
    </mah:MetroWindow.Flyouts>


    <Border xmlns:local="clr-namespace:Inventory_System.MainWindows"
            xmlns:vm="clr-namespace:Inventory_System.viewo_Model"
            xmlns:conv="clr-namespace:Inventory_System.converts"
            x:Name="mybo" Background="{StaticResource Workspace.Canvas}"
            BorderBrush="{StaticResource Workspace.Line}" BorderThickness="1"
            CornerRadius="18" Margin="6" vm:RoundedSurface.Radius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Workspace.Header}" CornerRadius="18,18,0,0">
                <Grid>
                    <Grid Margin="20,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MouseLeftButtonDown="TitleSurface_MouseLeftButtonDown">
                            <Border Width="48" Height="48" CornerRadius="13" Background="White" Margin="0,0,14,0">
                                <Image Source="pack://application:,,,/Inventory_System;component/Resources/ssf Logo.jpg" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="منظومة حصر المقرات" Foreground="White" FontSize="25" FontWeight="SemiBold"/>
                                <TextBlock Text="صندوق الضمان الاجتماعي" Foreground="#D6E2F3" FontSize="13" Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- جرس دائم وعدّاد DevExpress لعدد الإشعارات غير المقروءة. -->
                            <dx:SimpleButton  dx:ThemeManager.ThemeName="Win11Light" x:Name="NotificationBell" Visibility="Collapsed" Click="NotificationBell_Click" Margin="12,0,16,0" Width="51" Height="42" Background="#3A608F" Foreground="White" ToolTip="إشعارات الصيانة" AutomationProperties.Name="إشعارات الصيانة">
                                <dx:Badge.Badge  >
                                    <dx:Badge x:Name="NoticeBadge" Content="0" Visibility="Collapsed" Background="Red" Foreground="White" AnimationDuration="5"/>
                                </dx:Badge.Badge>
                                <icons:PackIconMaterial Kind="BellOutline" Width="23" Height="23"/>
                            </dx:SimpleButton>
                            <dx:SimpleButton x:Name="MinimizeWindowButton" Click="MinimizeWindow_Click" Style="{StaticResource Dcms.WindowButton}" ToolTip="تصغير" AutomationProperties.Name="تصغير النافذة">
                                <icons:PackIconMaterial Kind="WindowMinimize" Width="17" Height="17"/>
                            </dx:SimpleButton>
                            <dx:SimpleButton x:Name="MaximizeWindowButton" Click="MaximizeWindow_Click" Style="{StaticResource Dcms.WindowButton}" ToolTip="تكبير أو استعادة" AutomationProperties.Name="تكبير أو استعادة النافذة">
                                <icons:PackIconMaterial Width="17" Height="17">
                                    <icons:PackIconMaterial.Style>
                                        <Style TargetType="icons:PackIconMaterial">
                                            <Setter Property="Kind" Value="WindowMaximize"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                    <Setter Property="Kind" Value="WindowRestore"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </icons:PackIconMaterial.Style>
                                </icons:PackIconMaterial>
                            </dx:SimpleButton>
                            <dx:SimpleButton x:Name="CloseWindowButton" Click="CloseWindow_Click" Style="{StaticResource Dcms.WindowButton}" Background="#32DF6363" ToolTip="إغلاق المنظومة" AutomationProperties.Name="إغلاق المنظومة">
                                <icons:PackIconMaterial Kind="Close" Width="18" Height="18"/>
                            </dx:SimpleButton>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Workspace.Line}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,24,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SettingsTab" Content="ملف" Tag="settings" GroupName="WorkspaceSections" Style="{StaticResource Workspace.Tab}" Checked="WorkspaceSection_Checked"/>
                        <RadioButton x:Name="TransactionsTab" Content="حصر المقرات" Tag="operations" GroupName="WorkspaceSections" Style="{StaticResource Workspace.Tab}" IsChecked="True" Checked="WorkspaceSection_Checked"/>
                        <RadioButton x:Name="ReferenceTab" Content="البيانات المساعدة" Tag="reference" GroupName="WorkspaceSections" Style="{StaticResource Workspace.Tab}" Checked="WorkspaceSection_Checked"/>
                        <RadioButton x:Name="ReportsTab" Content="التقارير" Tag="reports" GroupName="WorkspaceSections" Style="{StaticResource Workspace.Tab}" Checked="WorkspaceSection_Checked"/>
                        <RadioButton x:Name="HelpTab" Content="المساعدة" Tag="help" GroupName="WorkspaceSections" Style="{StaticResource Workspace.Tab}" Checked="WorkspaceSection_Checked"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Background="#F1F4F9" BorderBrush="{StaticResource Workspace.Line}" BorderThickness="0,0,0,1" Padding="16,2" Grid.Row="2">
                <workspace:AccessibleWorkspaceItemsControl x:Name="SectionCommands">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <dx:SimpleButton Click="QuickAccess_Click" IsEnabled="{Binding IsEnabled}" Style="{StaticResource Workspace.Ribbon}" Padding="12,4" AutomationProperties.Name="{Binding Title}" AutomationProperties.AcceleratorKey="{Binding Shortcut}" ToolTip="{Binding Description}">
                                <StackPanel>
                                    <icons:PackIconMaterial Kind="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <Border Background="{StaticResource Workspace.Tint}" CornerRadius="5" Padding="7,1" Margin="0,3,0,0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Shortcut}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Workspace.Muted}" FlowDirection="LeftToRight"/>
                                    </Border>
                                </StackPanel>
                            </dx:SimpleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </workspace:AccessibleWorkspaceItemsControl>
            </Border>
            <Grid ClipToBounds="True" Grid.Row="3" x:Name="WorkspaceCanvas" FlowDirection="LeftToRight">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- خلفية متجهة تملأ مساحة العمل، والرسمة تتمدد دون تشويه أو تداخل مع البطاقات. -->
                <Grid x:Name="WorkspaceBackdrop" Grid.RowSpan="3" Background="{StaticResource Workspace.Canvas}" IsHitTestVisible="False">
                    <Border Background="{StaticResource Workspace.Pattern}"/>
                </Grid>
                <!-- مساحة تعريف بهوية المؤسسة، بخلفية هندسية متجهة تحافظ على حدتها مع التحجيم. -->
                <Border Grid.Row="0" Margin="24,8,24,8" MaxWidth="1580" CornerRadius="16" BorderThickness="1"
                        BorderBrush="#314B70" Background="{StaticResource Workspace.Feature}" IsHitTestVisible="False" ClipToBounds="True">
                    <Grid>
                        <Border Width="4" HorizontalAlignment="Right" Background="#D6B66F" CornerRadius="0,18,18,0"/>
                        <TextBlock x:Name="WorkspaceHeroCompact" Text="صندوق الضمان الاجتماعي  /  حصر المقرات" Visibility="Collapsed"
                                   FontSize="14" Foreground="#F1E4C4" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                        <Grid x:Name="WorkspaceHeroContent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="20,8,12,8" MaxHeight="370">
                                <Canvas Width="650" Height="310">
                                    <!-- مخطط مبانٍ ومسارات خدمة، مع أدوات الصيانة في بطاقات عائمة. -->
                                    <Ellipse Canvas.Left="70" Canvas.Top="-100" Width="470" Height="470" Fill="#0A8FB6EF" Stroke="#255E82B6"/>
                                    <Ellipse Canvas.Left="110" Canvas.Top="-60" Width="390" Height="390" Stroke="#254D709F"/>
                                    <Path Data="M10,281 H640 M30,296 H590 M75,281 V135 L165,102 V281 M165,281 V72 H325 V281 M325,281 V162 H427 V281 M427,281 V120 H540 V281"
                                          Stroke="#7194C4" StrokeThickness="2" Opacity="0.8"/>
                                    <Path Data="M185,92 H305 M185,121 H305 M185,150 H305 M185,179 H305 M185,208 H305 M185,237 H305 M95,152 H145 M95,179 H145 M95,207 H145 M95,235 H145 M345,184 H405 M345,211 H405 M345,238 H405 M448,143 H519 M448,171 H519 M448,199 H519 M448,227 H519 M230,281 V252 H263 V281"
                                          Stroke="#557CA9" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M35,235 C110,235 94,36 226,36 C358,36 376,265 608,200" Stroke="#D6B66F" StrokeThickness="2" StrokeDashArray="4 6" Opacity="0.75"/>
                                    <Border Canvas.Left="116" Canvas.Top="29" Width="84" Height="84" Background="#F7F9FE" CornerRadius="22" BorderBrush="#C9D9EF" BorderThickness="1">
                                        <icons:PackIconMaterial Kind="WrenchOutline" Width="41" Height="41" Foreground="#314D7A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Canvas.Left="474" Canvas.Top="46" Width="64" Height="64" Background="#D6B66F" CornerRadius="18">
                                        <icons:PackIconMaterial Kind="OfficeBuildingOutline" Width="31" Height="31" Foreground="#172944" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Canvas.Left="350" Canvas.Top="230" Width="58" Height="58" Background="#345781" CornerRadius="16" BorderBrush="#6387B5" BorderThickness="1">
                                        <icons:PackIconMaterial Kind="CogOutline" Width="29" Height="29" Foreground="#E2EBFA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Ellipse Canvas.Left="47" Canvas.Top="222" Width="10" Height="10" Fill="#D6B66F"/>
                                    <Ellipse Canvas.Left="592" Canvas.Top="193" Width="10" Height="10" Fill="#D6B66F"/>
                                    <Path Data="M565,74 H580 M572.5,66.5 V81.5 M65,74 H77 M71,68 V80" Stroke="#90ACD2" StrokeThickness="2"/>
                                </Canvas>
                            </Viewbox>
                            <Viewbox x:Name="WorkspaceHeroFull" Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="20,14,42,14">
                                <StackPanel Width="610" FlowDirection="RightToLeft">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                        <Border Width="63" Height="59" Background="White" CornerRadius="16" Margin="0,0,14,0">
                                            <Image Source="pack://application:,,,/Inventory_System;component/Resources/ssf Logo.jpg" Margin="6" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Width="407">
                                            <TextBlock Text="صندوق الضمان الاجتماعي" Foreground="#F1E4C4" FontSize="30" FontWeight="SemiBold"/>
                                            <TextBlock Text="إدارة الشؤون الإدارية والخدمات" Foreground="#AFC3E0" FontSize="30" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="حصر المقرات" FontSize="48" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="تصميم وبرمجة إدارة تقنية المعلومات والاتصالات" Foreground="#F1E4C4" FontSize="30" Margin="0,10,0,0" FontWeight="Bold"/>
                                    <Border Background="#25D6B66F" Height="1" Margin="0,24,0,15"/>
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconMaterial Kind="FileDocumentOutline" Width="18" Height="18" Foreground="#D6B66F" Margin="0,0,7,0"/>
                                        <TextBlock Text="المقرات المملوكة" Foreground="#DCE6F6" FontSize="15"/>
                                        <TextBlock Text=" / " Foreground="#758EB2" Margin="16,0"/>
                                        <TextBlock Text="المقرات المؤجرة" Foreground="#DCE6F6" FontSize="15"/>
                                        <TextBlock Text=" / " Foreground="#758EB2" Margin="16,0"/>
                                        <TextBlock Text="السجلات والخدمات" Foreground="#DCE6F6" FontSize="15"/>
                                    </StackPanel>
                                </StackPanel>
                            </Viewbox>
                            <!-- نسخة متوسطة المقاس تبقي العنوان واضحًا بدل تصغير جميع التفاصيل. -->
                            <Grid x:Name="WorkspaceHeroMedium" Grid.Column="1" Visibility="Collapsed" Margin="24,10,34,10" VerticalAlignment="Center" FlowDirection="RightToLeft">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50" CornerRadius="15" Background="White" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <Image Source="pack://application:,,,/Inventory_System;component/Resources/ssf Logo.jpg" Margin="6" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="صندوق الضمان الاجتماعي" Foreground="#F1E4C4" FontSize="14" Margin="0,0,0,4"/>
                                    <TextBlock Text="حصر المقرات" Foreground="White" FontSize="27" FontWeight="Bold"/>
                                    <TextBlock Text="المقرات المملوكة والمؤجرة وسجلاتها" Foreground="#C6D5EB" FontSize="14" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                <!-- صف مستقل بارتفاع المحتوى يضم جميع أزرار الوصول السريع داخل البطاقة. -->
                <Grid Grid.Row="1" Margin="24,8,24,8" MaxWidth="1580" x:Name="QuickSlot">
                    <Border Background="{StaticResource Workspace.Surface}" CornerRadius="14" Padding="14,9" BorderBrush="{StaticResource Workspace.Line}" BorderThickness="1" x:Name="QuickAccessPanel" VerticalAlignment="Top" FlowDirection="RightToLeft">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconMaterial Kind="ViewDashboardOutline" Width="20" Height="20" Foreground="{StaticResource Workspace.Copper}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="العمليات الرئيسية" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Workspace.Ink}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <dx:SimpleButton Grid.Column="1" x:Name="CloseQuickAccessButton" Click="CloseQuickAccess_Click" Content="×" Width="32" Height="32" MinHeight="32" FontSize="22" Style="{StaticResource Workspace.Secondary}" Padding="0" AutomationProperties.Name="إخفاء الوصول السريع"/>
                            </Grid>
                            <workspace:AccessibleWorkspaceItemsControl x:Name="QuickAccessCommands" Grid.Row="1">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- يحسب عدد الصفوف تلقائيًا وفق عدد الأزرار بدل تجاوز الصف الواحد. -->
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <dx:SimpleButton Click="QuickAccess_Click" IsEnabled="{Binding IsEnabled}" Style="{StaticResource Workspace.Tile}" AutomationProperties.Name="{Binding Title}" AutomationProperties.AcceleratorKey="{Binding Shortcut}">
                                            <dx:SimpleButton.ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Description}"/>
                                                    <TextBlock Text="{Binding Shortcut}" FlowDirection="LeftToRight" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </dx:SimpleButton.ToolTip>
                                            <Grid>
                                                <!-- الأيقونة بجوار العنوان، والاختصار في طرف البطاقة، مع مساحة مرنة لالتفاف العربية. -->
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" Background="{StaticResource Workspace.Tint}" CornerRadius="8" VerticalAlignment="Center" Margin="0,0,7,0">
                                                    <icons:PackIconMaterial Kind="{Binding Icon}" Width="19" Height="19" Foreground="{StaticResource Workspace.Primary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,4,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Shortcut}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Workspace.Muted}" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                            </Grid>
                                        </dx:SimpleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </workspace:AccessibleWorkspaceItemsControl>
                        </Grid>
                    </Border>
                </Grid>
                <dx:SimpleButton x:Name="ShowQuickAccessButton" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="إظهار الوصول السريع" Click="ShowQuickAccess_Click" Visibility="Collapsed" Style="{StaticResource Workspace.Secondary}" Margin="20"/>
                <!-- إحصاءات التسجيل حسب نوع الحصر والسنة وصلاحية التقارير. -->
                <Grid Grid.Row="2" Margin="24,4,24,10" MaxWidth="1580" x:Name="StatisticsSlot">
                    <Border x:Name="StatisticsCard" Background="{StaticResource Workspace.Surface}" BorderBrush="{StaticResource Workspace.Line}"
                            BorderThickness="1" CornerRadius="14" Padding="14,10" FlowDirection="RightToLeft">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <icons:PackIconMaterial Kind="ChartBoxOutline" Width="20" Height="20" Foreground="{StaticResource Workspace.Copper}" Margin="0,0,9,0"/>
                                    <TextBlock Text="إحصاءات حصر المقرات السنوية" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Workspace.Ink}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Style="{StaticResource Dcms.IconField}">
                                        <DockPanel Margin="6,0">
                                            <icons:PackIconMaterial DockPanel.Dock="Left" Kind="CalendarOutline" Width="17" Height="17"
                                                                    VerticalAlignment="Center" Foreground="{StaticResource Workspace.Primary}" IsHitTestVisible="False"/>
                                            <!-- تنسيق السنة كعدد صحيح متصل أثناء العرض والتحرير. -->
                                            <dxe:SpinEdit x:Name="StatisticsYear" EditValueType="{x:Type sys:Int32}" IsFloatValue="False" MinValue="1900" MaxValue="9999"
                                                          MaskType="Numeric" Mask="d" MaskUseAsDisplayFormat="True"
                                                          ShowEditorButtons="True" Height="34" Width="92" FlowDirection="LeftToRight" Background="Transparent"
                                                          AutomationProperties.Name="سنة إحصاءات المقرات"/>
                                        </DockPanel>
                                    </Border>
                                    <dx:SimpleButton x:Name="RefreshStatisticsButton" Click="RefreshStatistics_Click" Style="{StaticResource Workspace.Secondary}"
                                                     Width="36" Height="36" MinHeight="36" Padding="0" Margin="8,0" ToolTip="تحديث الإحصاءات" AutomationProperties.Name="تحديث الإحصاءات">
                                        <icons:PackIconMaterial Kind="Refresh" Width="18" Height="18"/>
                                    </dx:SimpleButton>
                                </StackPanel>
                                <dx:SimpleButton Grid.Column="2" x:Name="CloseStatisticsButton" Click="CloseStatistics_Click" Style="{StaticResource Workspace.Secondary}"
                                                 Width="32" Height="32" MinHeight="32" Padding="0" AutomationProperties.Name="إخفاء الإحصاءات">
                                    <icons:PackIconMaterial Kind="Close" Width="15" Height="15"/>
                                </dx:SimpleButton>
                            </Grid>
                            <TextBlock DockPanel.Dock="Bottom" x:Name="StatisticsStatus" Foreground="{StaticResource Workspace.Muted}"
                                       TextWrapping="Wrap" FontSize="12" Margin="3,7,0,0"/>
                            <UniformGrid Columns="2">
                                <Border Background="{StaticResource Workspace.Tint}" CornerRadius="10" Padding="12,5" Margin="0,0,4,0">
                                    <DockPanel>
                                        <TextBlock x:Name="OwnedCount" DockPanel.Dock="Right" Text="—" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Workspace.Primary}"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <icons:PackIconMaterial Kind="OfficeBuildingOutline" Width="18" Height="18" Foreground="{StaticResource Workspace.Primary}" Margin="0,0,8,0"/>
                                            <TextBlock Text="المقرات المملوكة" FontWeight="SemiBold" Foreground="{StaticResource Workspace.Ink}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Background="{StaticResource Workspace.Tint}" CornerRadius="10" Padding="12,5" Margin="4,0,0,0">
                                    <DockPanel>
                                        <TextBlock x:Name="RentedCount" DockPanel.Dock="Right" Text="—" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Workspace.Primary}"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <icons:PackIconMaterial Kind="KeyOutline" Width="18" Height="18" Foreground="{StaticResource Workspace.Primary}" Margin="0,0,8,0"/>
                                            <TextBlock Text="المقرات المؤجرة" FontWeight="SemiBold" Foreground="{StaticResource Workspace.Ink}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </UniformGrid>
                        </DockPanel>
                    </Border>
                    <dx:SimpleButton x:Name="ShowStatisticsButton" HorizontalAlignment="Right" Content="إظهار الإحصائية"
                                     Click="ShowStatistics_Click" Visibility="Collapsed" Style="{StaticResource Workspace.Secondary}"/>
                </Grid>
            </Grid>
            <Border Grid.Row="4" Background="#E8EDF5" CornerRadius="0,0,14,14" BorderBrush="{StaticResource Workspace.Line}" BorderThickness="0,1,0,0" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconMaterial Kind="AccountOutline" Width="15" Height="15" Foreground="{StaticResource Workspace.Primary}" Margin="0,0,7,0"/>
                        <TextBlock x:Name="lus" Text="المستخدم" FontSize="12" Foreground="{StaticResource Workspace.Muted}" MaxWidth="250" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text=" / حصر المقرات" FontSize="12" Foreground="{StaticResource Workspace.Muted}" Margin="12,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock x:Name="vesion" Text="الإصدار 3.0.0.0" FontSize="12" Foreground="{StaticResource Workspace.Muted}" Margin="0,0,22,0"/>
                        <TextBlock x:Name="LDATE" FontSize="12" Foreground="{StaticResource Workspace.Muted}" FlowDirection="LeftToRight"/>
                        <TextBlock Text="  /  " FontSize="12" Foreground="{StaticResource Workspace.Muted}"/>
                        <TextBlock x:Name="ltim" FontSize="12" Foreground="{StaticResource Workspace.Muted}" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Existing menu items remain the command sources, including their permissions and handlers. -->
            <Menu xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:gif="http://wpfanimatedgif.codeplex.com" xmlns:vm="clr-namespace:Inventory_System.viewo_Model" xmlns:conv="clr-namespace:Inventory_System.converts" xmlns:simpleChildWindow="http://metro.mahapps.com/winfx/xaml/simplechildwindow" xmlns:d1="http://schemas.microsoft.com/expression/blend/2008" x:Name="menu1" KeyboardNavigation.TabNavigation="Continue" VerticalAlignment="Top" FontSize="14" FontWeight="Bold" BorderBrush="White" Padding="-3,0,0,0" BorderThickness="1,0,0,1" Grid.ColumnSpan="2" Background="#0D5EA6" Visibility="Collapsed">
                <MenuItem x:Name="credite_op" Header="_ملف" Background="{x:Null}" Foreground="#FFFBF8F8" Height="36" Width="52" TabIndex="1" SubmenuClosed="credite_op_SubmenuClosed" SubmenuOpened="credite_op_SubmenuOpened">
                    <MenuItem x:Name="inout_Menu" FocusManager.IsFocusScope="True" Header="المعاملات الواردة" InputGestureText="F7" BorderThickness="1,0,1,1" BorderBrush="{x:Null}" Background="#0D5EA6" Foreground="White" Click="inout_Menu_Click">
                        <MenuItem.Icon>
                            <iconPacks:PackIconMaterialDesign Kind="Difference" Height="55" Margin="2,0,3,0" Width="38"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="CompletionMenu" Header="تقرير إنهاء الصيانة" InputGestureText="F5" Click="CompletionMenu_Click" />
                    <MenuItem x:Name="work_his_Menu" FocusManager.IsFocusScope="True" Header="إفادة ضم خدمة" InputGestureText="F5" BorderThickness="1,0,1,1" BorderBrush="{x:Null}" Background="#0D5EA6" Foreground="White" Click="work_his_par_Click">
                        <MenuItem.Icon>
                            <iconPacks:PackIconMaterialDesign Kind="Difference" Height="55" Margin="2,0,3,0" Width="38"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="close" Header="إنــــــهــــــــاء" InputGestureText="Alt+F4" BorderBrush="{x:Null}" Background="#0D5EA6" Foreground="White" BorderThickness="1,0,1,1" Click="close_Click">
                        <MenuItem.Icon>
                            <iconPacks:PackIconMaterialDesign Kind="SettingsPower" Height="50" Margin="2,0,-26,0" Width="33"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem x:Name="Supports_Data" Header="ال_بيانات المساعدة" Background="{x:Null}" Foreground="#FFFBF8F8" Height="36" Width="124" TabIndex="1" SubmenuClosed="xcredite_op_SubmenuClosed" SubmenuOpened="xcredite_op_SubmenuOpened">
                    <!-- مصادر التكليف الفعلية؛ تبقى العناصر الموروثة أدناه دون حذف حتى لا ينكسر اختصار قديم. -->
                    <MenuItem x:Name="SupportBuildingsMenu" Header="المباني" Click="SupportBuildingsMenu_Click" InputGestureText="Ctrl+1" />
                    <MenuItem x:Name="SupportServicesMenu" Header="أنواع الخدمات" Click="SupportServicesMenu_Click" InputGestureText="Ctrl+2" />
                    <MenuItem x:Name="SupportEmployeesMenu" Header="الفنيون" Click="SupportEmployeesMenu_Click" InputGestureText="Ctrl+3" />
                    <MenuItem x:Name="SupportManagementsMenu" Header="الإدارات والأقسام" Click="SupportManagementsMenu_Click" InputGestureText="Ctrl+4" />
                    <MenuItem x:Name="SupportSectionsMenu" Header="الأقسام والوحدات" Click="SupportSectionsMenu_Click" InputGestureText="Ctrl+5" />
                    <Separator />
                </MenuItem>
                <MenuItem x:Name="REPORT_MNUE" Header="ال_تقارير" Background="{x:Null}" Foreground="#FFFBF8F8" Width="63" Height="36" TabIndex="3" IsEnabled="True" SubmenuClosed="REPORT_MNUE_SubmenuClosed" SubmenuOpened="REPORT_MNUE_SubmenuOpened">
                    <MenuItem x:Name="DailyInspectionMenu" Header="نموذج الفحص اليومي" InputGestureText="Alt+Y" Click="DailyInspection_Click">
                        <MenuItem.Icon>
                            <iconPacks:PackIconMaterial Kind="OfficeBuildingOutline" Width="22" Height="22"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="DailyInspectionSERVICEMenu" Header="نموذج الفحص اليومي للخدمات" InputGestureText="Alt+X" Click="DailyInspectionSERVICEMenu_Click">
                        <MenuItem.Icon>
                            <iconPacks:PackIconMaterial Kind="OfficeBuildingOutline" Width="22" Height="22"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="report_mnue" Click="report_mnue_Click" InputGestureText="CTRL+C" FocusManager.IsFocusScope="True" Header="تقارير الصيانة" Background="#0D5EA6" BorderThickness="1,0,1,1" BorderBrush="{x:Null}" Foreground="White" Width="279">
                        <MenuItem.Icon>
                            <iconPacks:PackIconMaterialDesign Kind="InsertChart" Height="55" Margin="2,0,3,0" Width="38"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="BranchReportsMenu" Header="تقارير الفروع" InputGestureText="Alt+T" Click="BranchReportsMenu_Click" IsEnabled="False">
                        <MenuItem.Icon>
                            <iconPacks:PackIconMaterial Kind="OfficeBuildingOutline" Width="22" Height="22"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="statistics_mnue" Click="statistics_mnue_Click" InputGestureText="CTRL+I" FocusManager.IsFocusScope="True" Header="إحصائية الصيانة" Background="#0D5EA6" BorderThickness="1,0,1,1" BorderBrush="{x:Null}" Foreground="White" Width="279">
                        <MenuItem.Icon>
                            <!-- InsertChart متاح في الإصدار المثبت من حزمة MaterialDesign. -->
                            <iconPacks:PackIconMaterialDesign Kind="InsertChart" Height="55" Margin="2,0,3,0" Width="38"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <!--<MenuItem x:Name="viewo_mnue"  Click="viewo_mnue_Click" InputGestureText="CTRL+D"  Style="{StaticResource mnuItems_Style}" FocusManager.IsFocusScope="True" Header="تقارير إفادة ضم الخدمة" Background="#0D5EA6"  BorderThickness="1,0,1,1" BorderBrush="{x:Null}" Foreground="White" Width="279" >
                        <MenuItem.Icon>
                            <iconPacks:PackIconMaterialDesign Kind="InsertChart" Height="55"  Margin="2,0,3,0" Width="38"/>
                        </MenuItem.Icon>

                    </MenuItem>-->
                </MenuItem>
               
                <MenuItem Header="المساعدة">
                    <MenuItem x:Name="AboutMenuItem" Header="حول النظام" InputGestureText="F1" Click="AboutSystem_Click"/>
                </MenuItem>
            </Menu>
            <!-- لوحة حديثة مرتبطة بالجرس، تغلق بالخارج أو Escape ولا تعطل بقية الرئيسية. -->
          
        </Grid>
    </Border>
</mah:MetroWindow>
