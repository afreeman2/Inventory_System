<mah:MetroWindow x:Class="Inventory_System.Inventory_Windows.owned_Windows.owned_Phone_Window"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" 
                 xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
                 xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:conv="clr-namespace:Inventory_System.converts" 

                 xmlns:vm="clr-namespace:Inventory_System.viewo_Model"
                 Title="متابعة فواتير خطوط الهاتف للمقرات المملوكة" 
                 Width="1920" Height="1080" MinWidth="960" MinHeight="700"
                 WindowState="Maximized" ResizeMode="CanResize"
                 WindowStartupLocation="CenterOwner" WindowStyle="None"
                 AllowsTransparency="True" Background="Transparent" 
                 BorderThickness="0" ShowTitleBar="False" ShowCloseButton="False" 
                 ShowMinButton="False" ShowMaxRestoreButton="False"
                 GlowBrush="{x:Null}" FlowDirection="RightToLeft" FontFamily="Segoe UI"
                 FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" 
                 dx:ThemeManager.ThemeName="Win11Light" vm:RoundedWindowFrame.Enabled="True"
                                      xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"

                  DataContext="{dxmvvm:ViewModelSource Type=vm:owned_Phone_Viewomodel}"
                 Loaded="MetroWindow_Loaded"
                 PreviewKeyDown="PhoneWindow_KeyDown">
    <mah:MetroWindow.Resources>
        

        <conv:PowerDisplayNumberConverter x:Key="Phone.NumberDisplay" />
        <Style TargetType="vm:AccessibleGridControl" BasedOn="{StaticResource {x:Type dxg:GridControl}}" />
        <!-- إطار وأيقونة ومحررات تتبع هوية المنظومة وقالب التحقق العام. -->
        <Style x:Key="Phone.Field" TargetType="Border" BasedOn="{StaticResource Dcms.IconField}">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="Phone.Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Workspace.Ink}" />
        </Style>
        <Style x:Key="Phone.Text" TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="5,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="conv:FieldFeedback.Enabled" Value="True" />
        </Style>
        <Style x:Key="Phone.Date" TargetType="DatePicker" BasedOn="{StaticResource MahApps.Styles.DatePicker}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="conv:FieldFeedback.Enabled" Value="True" />
        </Style>
        <Style x:Key="Phone.Combo" TargetType="ComboBox" BasedOn="{StaticResource MahApps.Styles.ComboBox}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="conv:FieldFeedback.Enabled" Value="True" />
        </Style>
        <Style x:Key="Phone.Number" TargetType="dxe:SpinEdit">
            <Setter Property="ShowBorder" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Mask" Value="n3" />
            <Setter Property="MaskUseAsDisplayFormat" Value="True" />
            <Setter Property="AllowNullInput" Value="True" />
            <Setter Property="ShowEditorButtons" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="conv:FieldFeedback.Enabled" Value="True" />
            <Setter Property="ShowError" Value="False" />
            <Setter Property="ShowErrorToolTip" Value="False" />
        </Style>
        <!-- لا تتفعل أوامر البيانات إلا عند توفيرها في سياق الواجهة؛ يسبق التحقق تنفيذها. -->
        <Style x:Key="Phone.Action" TargetType="dx:SimpleButton" BasedOn="{StaticResource Dcms.PrimaryButton}">
            <Setter Property="MinWidth" Value="148" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </mah:MetroWindow.Resources>
    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl>
            <!-- لوحة المصدر معرفة بالكامل في XAML داخل Flyouts النافذة؛ فتح سفلي وبطاقة وسطية بهوية المنظومة. -->
            <mah:Flyout x:Name="Engry_Windows" Style="{StaticResource Maintenance.Flyout}" IsOpenChanged="PhoneFlyout_Changed">
                <Border x:Name="PhoneCard" Style="{StaticResource Maintenance.Flyout.Card}" Width="900" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource Workspace.Header}" CornerRadius="17,17,0,0" Padding="20,14">
                            <DockPanel>
                                <dx:SimpleButton x:Name="btnCancel_eng" Click="CancelDraft_Click" Style="{StaticResource Dcms.WindowButton}" DockPanel.Dock="Right" ToolTip="إغلاق حصر فواتير خطوط الهاتف" AutomationProperties.Name="إغلاق حصر فواتير خطوط الهاتف">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconMaterial Kind="Close" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                    </StackPanel>
                                </dx:SimpleButton>
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Foreground="{StaticResource Maintenance.Flyout.HeaderIcon}" Margin="0,0,12,0">
                                        <icons:PackIconMaterial Kind="PhoneInTalkOutline" Width="28" Height="28" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                    </ContentControl>
                                    <TextBlock x:Name="PhoneDraftTitle" Text="بيانات فواتير خطوط الهاتف" Foreground="White" FontSize="23" FontWeight="SemiBold" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel x:Name="PhoneFields" Margin="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="رقم الهاتف" Style="{StaticResource Phone.Label}" />
                                        <Border Style="{StaticResource Phone.Field}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Foreground="{StaticResource Workspace.Primary}" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center">
                                                    <icons:PackIconMaterial Kind="PhoneOutline" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                                </ContentControl>
                                                <Grid Grid.Column="1">
                                                    <TextBox AutomationProperties.Name="رقم الهاتف" PreviewKeyDown="Field_KeyDown" x:Name="Text_Elec_meter" MaxLength="15" Style="{StaticResource Phone.Text}" TabIndex="101" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="المستفيد" Style="{StaticResource Phone.Label}" />
                                        <Border Style="{StaticResource Phone.Field}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Foreground="{StaticResource Workspace.Primary}" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center">
                                                    <icons:PackIconMaterial Kind="AccountOutline" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                                </ContentControl>
                                                <Grid Grid.Column="1">
                                                    <!-- المستفيد نص كما في شاشة الهاتف القديمة؛ ليس قراءة عداد رقمية. -->
                                                    <TextBox AutomationProperties.Name="المستفيد" PreviewKeyDown="Field_KeyDown" x:Name="Text_engry_Read" MaxLength="50" Style="{StaticResource Phone.Text}" TabIndex="102" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="4" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="قيمة الفاتورة" Style="{StaticResource Phone.Label}" />
                                        <Border Style="{StaticResource Phone.Field}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Foreground="{StaticResource Workspace.Primary}" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center">
                                                    <icons:PackIconMaterial Kind="CashMultiple" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                                </ContentControl>
                                                <Grid Grid.Column="1">
                                                    <dxe:SpinEdit AutomationProperties.Name="قيمة الفاتورة" PreviewKeyDown="Field_KeyDown" x:Name="Text_Electric_Value" Style="{StaticResource Phone.Number}" TabIndex="103" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="تاريخ الفاتورة" Style="{StaticResource Phone.Label}" />
                                        <Border Style="{StaticResource Phone.Field}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Foreground="{StaticResource Workspace.Primary}" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center">
                                                    <icons:PackIconMaterial Kind="CalendarMonthOutline" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                                </ContentControl>
                                                <Grid Grid.Column="1">
                                                    <DatePicker AutomationProperties.Name="تاريخ الفاتورة" PreviewKeyDown="Field_KeyDown" x:Name="date_Engry" Style="{StaticResource Phone.Date}" TabIndex="104" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="2" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="رقم الفاتورة" Style="{StaticResource Phone.Label}" />
                                        <Border Style="{StaticResource Phone.Field}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Foreground="{StaticResource Workspace.Primary}" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center">
                                                    <icons:PackIconMaterial Kind="FileDocumentOutline" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                                </ContentControl>
                                                <Grid Grid.Column="1">
                                                    <TextBox AutomationProperties.Name="رقم الفاتورة" PreviewKeyDown="Field_KeyDown" x:Name="Text_Engry_inv" MaxLength="50" Style="{StaticResource Phone.Text}" TabIndex="105" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="4" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="الدين الحالي" Style="{StaticResource Phone.Label}" />
                                        <Border Style="{StaticResource Phone.Field}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Foreground="{StaticResource Workspace.Primary}" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center">
                                                    <icons:PackIconMaterial Kind="CashClock" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                                </ContentControl>
                                                <Grid Grid.Column="1">
                                                    <dxe:SpinEdit AutomationProperties.Name="الدين الحالي" PreviewKeyDown="Field_KeyDown" x:Name="Text_engry_Debts" Style="{StaticResource Phone.Number}" TabIndex="106" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="من تاريخ" Style="{StaticResource Phone.Label}" />
                                        <Border Style="{StaticResource Phone.Field}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Foreground="{StaticResource Workspace.Primary}" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center">
                                                    <icons:PackIconMaterial Kind="CalendarStart" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                                </ContentControl>
                                                <Grid Grid.Column="1">
                                                    <DatePicker AutomationProperties.Name="من تاريخ" PreviewKeyDown="Field_KeyDown" x:Name="date_Eng_from" Style="{StaticResource Phone.Date}" TabIndex="107" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="2" Grid.Column="2" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="إلى تاريخ" Style="{StaticResource Phone.Label}" />
                                        <Border Style="{StaticResource Phone.Field}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Foreground="{StaticResource Workspace.Primary}" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center">
                                                    <icons:PackIconMaterial Kind="CalendarEnd" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                                </ContentControl>
                                                <Grid Grid.Column="1">
                                                    <DatePicker AutomationProperties.Name="إلى تاريخ" PreviewKeyDown="Field_KeyDown" x:Name="date_Eng_to" Style="{StaticResource Phone.Date}" TabIndex="108" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <!-- يحفظ الحدث الإضافة أو التعديل مثل العقود بعد التحقق من جميع خانات الفاتورة. -->
                                <dx:SimpleButton x:Name="Save_Eng" Click="SavePhone_Click" Style="{StaticResource Dmc.PrimaryButton}" TabIndex="109">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconMaterial Kind="ContentSaveOutline" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                        <TextBlock Text="حفظ" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </dx:SimpleButton>
                                <dx:SimpleButton x:Name="cancl_eng" Click="CancelDraft_Click" Style="{StaticResource Dcms.SecondaryButton}" MinWidth="148" Margin="12,0,0,0" TabIndex="110">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconMaterial Kind="Close" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                        <TextBlock Text="إلغاء الأمر" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </dx:SimpleButton>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </mah:Flyout>
        </mah:FlyoutsControl>
    </mah:MetroWindow.Flyouts>
    <Border x:Name="mybo" CornerRadius="18" Background="{StaticResource Workspace.Canvas}" BorderBrush="{StaticResource Workspace.Line}" BorderThickness="1" Margin="6">
        <DockPanel>
            <Border DockPanel.Dock="Top" CornerRadius="17,17,0,0" Background="{StaticResource Workspace.Header}" Padding="22,16">
                <DockPanel>
                    <dx:SimpleButton x:Name="btnCancel" Click="Close_Click" Style="{StaticResource Dcms.WindowButton}" ToolTip="إغلاق" AutomationProperties.Name="إغلاق فواتير خطوط الهاتف" DockPanel.Dock="Right">
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconMaterial Kind="Close" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                        </StackPanel>
                    </dx:SimpleButton>
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Foreground="{StaticResource Maintenance.Flyout.HeaderIcon}" Margin="0,0,14,0">
                            <icons:PackIconMaterial Kind="PhoneInTalkOutline" Width="34" Height="34" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                        </ContentControl>
                        <StackPanel>
                            <TextBlock Text="متابعة فواتير خطوط الهاتف للمقرات المملوكة" FontSize="25" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="حصر المقرات المملوكة · فواتير خطوط الهاتف" Foreground="#D6E2F3" Margin="0,5,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border CornerRadius="14" Background="{StaticResource Workspace.Surface}" BorderBrush="{StaticResource Workspace.Line}" BorderThickness="1" Padding="20" Margin="0,0,0,18">
                    <StackPanel>
                        <!-- ترتيب فلاتر المصدر محفوظ مع فواصل متساوية ومحررات مرنة دون هوامش سالبة. -->
                        <Grid x:Name="PhoneFilters">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <StackPanel>
                                    <TextBlock Text="المقر" Style="{StaticResource Phone.Label}" />
                                    <Border Style="{StaticResource Phone.Field}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Foreground="{StaticResource Workspace.Primary}" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center">
                                                <icons:PackIconMaterial Kind="OfficeBuildingOutline" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                            </ContentControl>
                                            <Grid Grid.Column="1">
                                                <ComboBox AutomationProperties.Name="المقر" PreviewKeyDown="Field_KeyDown" SelectionChanged="Combo_Locaton_SelectionChanged" x:Name="Combo_Locaton" Style="{StaticResource Phone.Combo}" ItemsSource="{Binding T_Inventory_Locations}" DisplayMemberPath="In_Location" SelectedValuePath="In_Location_ID" mah:TextBoxHelper.Watermark="اختر المقر" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Column="2">
                                <StackPanel>
                                    <CheckBox x:Name="Date_Check" Content="للبحث من تاريخ" Height="27" Margin="0,0,0,0" Click="DateFilter_Click" />
                                    <Border IsEnabled="{Binding IsChecked, ElementName=Date_Check}" Style="{StaticResource Phone.Field}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Foreground="{StaticResource Workspace.Primary}" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center">
                                                <icons:PackIconMaterial Kind="CalendarStart" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                            </ContentControl>
                                            <Grid Grid.Column="1">
                                                <DatePicker AutomationProperties.Name="للبحث من تاريخ" PreviewKeyDown="Field_KeyDown" x:Name="date_br_begin" Style="{StaticResource Phone.Date}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Column="4">
                                <StackPanel>
                                    <TextBlock Text="إلى تاريخ" Style="{StaticResource Phone.Label}" />
                                    <Border IsEnabled="{Binding IsChecked, ElementName=Date_Check}" Style="{StaticResource Phone.Field}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Foreground="{StaticResource Workspace.Primary}" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center">
                                                <icons:PackIconMaterial Kind="CalendarEnd" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                            </ContentControl>
                                            <Grid Grid.Column="1">
                                                <DatePicker AutomationProperties.Name="إلى تاريخ" PreviewKeyDown="Field_KeyDown" x:Name="date_br_end" Style="{StaticResource Phone.Date}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Column="6">
                                <StackPanel>
                                    <CheckBox x:Name="by_metar" Content="برقم الهاتف" Height="27" Margin="0,0,0,0" Click="MeterFilter_Click" />
                                    <Border x:Name="emp_bor" IsEnabled="{Binding IsChecked, ElementName=by_metar}" Style="{StaticResource Phone.Field}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Foreground="{StaticResource Workspace.Primary}" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center">
                                                <icons:PackIconMaterial Kind="PhoneOutline" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                            </ContentControl>
                                            <Grid Grid.Column="1">
                                                <TextBox AutomationProperties.Name="برقم الهاتف" PreviewKeyDown="Field_KeyDown" x:Name="txt_metar" MaxLength="15" Style="{StaticResource Phone.Text}" mah:TextBoxHelper.Watermark="أدخل رقم الهاتف" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <dx:SimpleButton x:Name="Search_Button" Click="SearchPhone_Click" Style="{StaticResource Dcms.PrimaryButton}" Width="148" Height="48">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconMaterial Kind="Magnify" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBlock Text="عرض" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </dx:SimpleButton>
                            <dx:SimpleButton x:Name="Insert" Click="NewPhone_Click" Style="{StaticResource Dcms.PrimaryButton}" MinWidth="148" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconMaterial Kind="FilePlusOutline" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBlock Text="إدراج جديد" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </dx:SimpleButton>
                            <dx:SimpleButton x:Name="But_Cancl" Click="ClearFilters_Click" Style="{StaticResource Dcms.SecondaryButton}" MinWidth="148" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconMaterial Kind="CloseCircleOutline" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBlock Text="إلغاء الأمر" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </dx:SimpleButton>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" CornerRadius="14" Background="{StaticResource Workspace.Surface}" BorderBrush="{StaticResource Workspace.Line}" BorderThickness="1" Padding="14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,14">
                            <ContentControl Foreground="{StaticResource Workspace.Primary}" Margin="0,0,10,0">
                                <icons:PackIconMaterial Kind="TableLarge" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                            </ContentControl>
                            <TextBlock Text="سجل فواتير خطوط الهاتف" Foreground="{StaticResource Workspace.Ink}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <Grid>
                            <!-- جدول DevExpress بديل Syncfusion، مع أسماء حقول المصدر وترتيبها وتوسيط الرؤوس والخلايا. -->
                            <!-- نمنع صفوف المصمم النصية مثل string1 من الوصول إلى أعمدة الأرقام والتواريخ؛ بيانات التشغيل لا تتغير. -->
                            <!-- مصدر العرض الفوري موجود في ItemsSource؛ نموذج العرض نفسه ليس قائمة فواتير. -->
                            <dxg:GridControl x:Name="engry_List" DesignTimeDataSourceRowCount="0" AutoGenerateColumns="None" SelectionMode="Row" MouseDoubleClick="PhoneRow_DoubleClick" RestoreStateKeyFieldName="ID" RestoreStateOnSourceChange="True" ItemsSource="{Binding ItemsSource, Mode=OneWay}">
                                <dxg:GridControl.View>
                                    <dxg:TableView ShowGroupPanel="False" AutoWidth="True" AllowEditing="False" ShowIndicator="False" RowMinHeight="42" HeaderPanelMinHeight="42" HeaderHorizontalAlignment="Center" ColumnHeaderStyle="{StaticResource Modern.GridHeader}" NavigationStyle="Row" ShowSearchPanelMode="Never" AllowPerPixelScrolling="True" />
                                </dxg:GridControl.View>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="V_Phone" Header="رقم الهاتف" Width="140" MinWidth="85" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:TextEdit x:Name="PART_Editor" HorizontalContentAlignment="Center" FontSize="14" Style="{StaticResource Dmc.GridCellText}" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="benef" Header="المستفيد" Width="190" MinWidth="85" HorizontalHeaderContentAlignment="Center">
                                        <!-- يعرض اسم المستفيد كنص كما هو مسجل في الفاتورة. -->
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:TextEdit x:Name="PART_Editor" HorizontalContentAlignment="Center" FontSize="14" Style="{StaticResource Dmc.GridCellText}" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="Phone_Value" Header="القيمة" Width="125" MinWidth="85" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayTextConverter="{StaticResource Phone.NumberDisplay}" HorizontalContentAlignment="Center" />
                                        </dxg:GridColumn.EditSettings>
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:TextEdit x:Name="PART_Editor" HorizontalContentAlignment="Center" FontSize="14" Style="{StaticResource Dmc.GridCellText}" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="debts_value" Header="قيمة الدين" Width="125" MinWidth="85" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayTextConverter="{StaticResource Phone.NumberDisplay}" HorizontalContentAlignment="Center" />
                                        </dxg:GridColumn.EditSettings>
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:TextEdit x:Name="PART_Editor" HorizontalContentAlignment="Center" FontSize="14" Style="{StaticResource Dmc.GridCellText}" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="phone_inv" Header="رقم الفاتورة" Width="125" MinWidth="85" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:TextEdit x:Name="PART_Editor" HorizontalContentAlignment="Center" FontSize="14" Style="{StaticResource Dmc.GridCellText}" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="Date_Input" Header="تاريخ الفاتورة" Width="135" MinWidth="105" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings DisplayFormat="dd-MM-yyyy" Mask="dd-MM-yyyy" MaskUseAsDisplayFormat="True" />
                                        </dxg:GridColumn.EditSettings>
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:TextEdit x:Name="PART_Editor" HorizontalContentAlignment="Center" FontSize="14" Style="{StaticResource Dmc.GridCellText}" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="From_Date" Header="من تاريخ" Width="135" MinWidth="105" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings DisplayFormat="dd-MM-yyyy" Mask="dd-MM-yyyy" MaskUseAsDisplayFormat="True" />
                                        </dxg:GridColumn.EditSettings>
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:TextEdit x:Name="PART_Editor" HorizontalContentAlignment="Center" FontSize="14" Style="{StaticResource Dmc.GridCellText}" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="To_Date" Header="إلى تاريخ" Width="135" MinWidth="105" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings DisplayFormat="dd-MM-yyyy" Mask="dd-MM-yyyy" MaskUseAsDisplayFormat="True" />
                                        </dxg:GridColumn.EditSettings>
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:TextEdit x:Name="PART_Editor" HorizontalContentAlignment="Center" FontSize="14" Style="{StaticResource Dmc.GridCellText}" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="حذف"   Width="70" MinWidth="62" HorizontalHeaderContentAlignment="Center" AllowSorting="False" AllowColumnFiltering="False">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- نأخذ أمر الحذف من نموذج الجدول ونمرر صف الزر نفسه، دون الاعتماد على الصف المحدد. -->
                                                <dx:SimpleButton Command="{Binding DataContext.DeletePhoneCommand, RelativeSource={RelativeSource AncestorType={x:Type dxg:GridControl}}}" CommandParameter="{Binding RowData.Row}" Padding="4" MinHeight="30"  ToolTip="حذف فاتورة الهاتف" AutomationProperties.Name="حذف فاتورة الهاتف">
                                                   
                                                    <ContentControl Foreground="#B42318">
                                                        <icons:PackIconMaterial Kind="DeleteOutline" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                                    </ContentControl>
                                                </dx:SimpleButton>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                            </dxg:GridControl>
                            <dx:LoadingDecorator x:Name="sfBusyIndicator" IsSplashScreenShown="{Binding IsBusy, FallbackValue=False}" IsHitTestVisible="False" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</mah:MetroWindow>
