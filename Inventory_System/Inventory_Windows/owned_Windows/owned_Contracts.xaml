<mah:MetroWindow x:Class="Inventory_System.Inventory_Windows.owned_Windows.owned_Contracts"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" 
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
 xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
 xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
                     
xmlns:vm="clr-namespace:Inventory_System.viewo_Model"
 xmlns:conv="clr-namespace:Inventory_System.converts"
                     xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                 DataContext="{dxmvvm:ViewModelSource Type=vm:owned_contrect_viewomodel}"
                     xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"

 Title="متابعة عقود المقرات المملوكة" Width="1920" Height="1080" MinWidth="960" MinHeight="700"
 WindowState="Maximized" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" WindowStyle="None"
 AllowsTransparency="True" Background="Transparent" BorderThickness="0" ShowTitleBar="False" ShowCloseButton="False" ShowMinButton="False" ShowMaxRestoreButton="False" GlowBrush="{x:Null}"
 FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
 dx:ThemeManager.ThemeName="Win11Light" vm:RoundedWindowFrame.Enabled="True" PreviewKeyDown="Contracts_PreviewKeyDown"
                 Loaded="MetroWindow_LoadedAsync">
    <mah:MetroWindow.Resources>
        <DataTemplate x:Key="ButtonCellTemplate">
            <dx:SimpleButton Command="{Binding DeleteCommand, ElementName=EditFormBehavior}" CommandParameter="{Binding Row}" IsEnabled="True">
                <iconPacks:PackIconMaterialDesign Foreground="Red" Kind="Delete" Height="22" Width="30" />
            </dx:SimpleButton>
        </DataTemplate>

        <!-- أسماء حقول المصدر ومسارات بياناته محفوظة، مع تطبيق هوية المنظومة الحالية. -->
        <Style TargetType="vm:AccessibleGridControl" BasedOn="{StaticResource {x:Type dxg:GridControl}}"/>
          <Style x:Key="Contracts.Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Workspace.Ink}"/>
        </Style>
        
        <Style x:Key="Contracts.Field" TargetType="Border" BasedOn="{StaticResource Dcms.IconField}">
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Validation.FieldError}"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Style.Triggers>
                <!-- تحتفظ الخانة الممتلئة بتمييز واضح أثناء التركيز. -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="vm:InputFieldState.HasValue" Value="True"/>
                        <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#DCE6F5"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
      
        <Style x:Key="Contracts.Icon" TargetType="icons:PackIconMaterial">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Workspace.Primary}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="Contracts.Combo" TargetType="ComboBox" BasedOn="{StaticResource MahApps.Styles.ComboBox}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="conv:FieldFeedback.Enabled" Value="True"/>
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Validation.FieldError}"/>
        </Style>
        <!-- يتمدد محرر التاريخ داخل البورد، ويستعمل قالب MahApps المتناسق بدل القالب الافتراضي ذي الإطار الداخلي. -->
        <Style x:Key="Contracts.Date" TargetType="DatePicker" BasedOn="{StaticResource MahApps.Styles.DatePicker}">
            <!-- ينقل Enter التركيز خارج أجزاء محرر التاريخ إلى الخانة التالية. -->
            <EventSetter Event="PreviewKeyDown" Handler="ContractDate_PreviewKeyDown"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="conv:FieldFeedback.Enabled" Value="True"/>
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Validation.FieldError}"/>
        </Style>
        <!-- ترتبط أوامر البيانات بسياق العمل عند نقله؛ لا ينفذ التصميم حفظًا أو حذفًا صوريًا. -->
        <Style x:Key="Contracts.DataAction" TargetType="dx:SimpleButton" BasedOn="{StaticResource Dcms.PrimaryButton}">
            <Style.Triggers>
                <Trigger Property="Command" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </mah:MetroWindow.Resources>
    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl>
            <!-- لوحة الإدراج الأصلية داخل Flyouts النظامية، ببطاقة متوسطة وتصميم كامل في XAML. -->
            <mah:Flyout x:Name="Engry_Windows" Style="{StaticResource Maintenance.Flyout}" IsOpenChanged="ContractFlyout_IsOpenChanged">
                <Border Style="{StaticResource Maintenance.Flyout.Card}" Width="700" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource Workspace.Header}" CornerRadius="17,17,0,0" Padding="20,14">
                            <DockPanel>
                                <dx:SimpleButton x:Name="btnCancel_eng" DockPanel.Dock="Right" Click="CancelContract_Click" Style="{StaticResource Dcms.WindowButton}" ToolTip="إغلاق بيانات العقد" AutomationProperties.Name="إغلاق بيانات العقد">
                                    <icons:PackIconMaterial Kind="Close" Width="22" Height="22"/>
                                </dx:SimpleButton>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <icons:PackIconMaterial Kind="FileDocumentEditOutline" Width="26" Height="26" Foreground="{StaticResource Maintenance.Flyout.HeaderIcon}" Margin="0,0,12,0"/>
                                    <TextBlock Text="بيانات عقود المقرات" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel x:Name="ContractFields" Margin="24">
                            <TextBlock Text="رقم العقد / بيان العقد" Style="{StaticResource Contracts.Label}"/>
                            <Border Style="{StaticResource Contracts.Field}">
                                <DockPanel>
                                    <icons:PackIconMaterial DockPanel.Dock="Left" Kind="FileDocumentOutline" Style="{StaticResource Contracts.Icon}"/>
                                    <TextBox x:Name="Text_Elec_meter" MaxLength="103" BorderThickness="0" Background="Transparent" Padding="4,10" MinHeight="46" VerticalContentAlignment="Center" conv:FieldFeedback.Enabled="True" Validation.ErrorTemplate="{StaticResource Validation.FieldError}" mah:TextBoxHelper.Watermark="أدخل رقم العقد أو بيانه" AutomationProperties.Name="رقم العقد أو بيانه">
                                        <TextBox.Tag>
                                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="Tag" Mode="TwoWay" UpdateSourceTrigger="Explicit" NotifyOnValidationError="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" ValidatesOnNotifyDataErrors="True">
                                                <Binding.ValidationRules>
                                                    <conv:ErrorRule />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Tag>
                                    </TextBox>
                                </DockPanel>
                            </Border>
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="تاريخ البيان" Style="{StaticResource Contracts.Label}"/>
                                    <Border Style="{StaticResource Contracts.Field}">
                                        <DockPanel>
                                            <icons:PackIconMaterial DockPanel.Dock="Left" Kind="CalendarMonthOutline" Style="{StaticResource Contracts.Icon}"/>
                                            <DatePicker x:Name="date_Engry" Style="{StaticResource Contracts.Date}" AutomationProperties.Name="تاريخ بيان العقد">
                                                <DatePicker.Tag>
                                                    <Binding RelativeSource="{RelativeSource Mode=Self}" Path="Tag" Mode="TwoWay" UpdateSourceTrigger="Explicit" NotifyOnValidationError="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" ValidatesOnNotifyDataErrors="True">
                                                        <Binding.ValidationRules>
                                                            <conv:ErrorRule />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </DatePicker.Tag>
                                            </DatePicker>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="المستفيد" Style="{StaticResource Contracts.Label}"/>
                                    <DockPanel>
                                        <dx:SimpleButton x:Name="Add_benef" DockPanel.Dock="Right" Width="48" Margin="8,0,0,0" Padding="0" Click="Add_benef_Click" Style="{StaticResource Dcms.PrimaryButton}" ToolTip="إضافة مستفيد" AutomationProperties.Name="إضافة مستفيد">
                                            <icons:PackIconMaterial Kind="AccountPlusOutline" Width="23" Height="23"/>
                                        </dx:SimpleButton>
                                        <Border Style="{StaticResource Contracts.Field}">
                                            <DockPanel>
                                                <icons:PackIconMaterial DockPanel.Dock="Left" Kind="AccountOutline" Style="{StaticResource Contracts.Icon}"/>
                                                <ComboBox x:Name="Combo_benef1" ItemsSource="{Binding T_Benef}" DisplayMemberPath="Benef" SelectedValuePath="Benef_ID" Style="{StaticResource Contracts.Combo}" mah:TextBoxHelper.Watermark="اختر المستفيد" AutomationProperties.Name="اختر المستفيد">
                                                    <ComboBox.Tag>
                                                        <Binding RelativeSource="{RelativeSource Mode=Self}" Path="Tag" Mode="TwoWay" UpdateSourceTrigger="Explicit" NotifyOnValidationError="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" ValidatesOnNotifyDataErrors="True">
                                                            <Binding.ValidationRules>
                                                                <conv:ErrorRule />
                                                            </Binding.ValidationRules>
                                                        </Binding>
                                                    </ComboBox.Tag>
                                                </ComboBox>
                                            </DockPanel>
                                        </Border>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                                <dx:SimpleButton x:Name="Save_Eng" Style="{StaticResource Dcms.PrimaryButton}" Click="Save_Eng_ClickAsync">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconMaterial Kind="ContentSaveOutline" Width="22" Height="22" Margin="0,0,8,0"/>
                                        <TextBlock Text="حفظ"/>
                                    </StackPanel>
                                </dx:SimpleButton>
                                <dx:SimpleButton x:Name="cancl_eng" Style="{StaticResource Dcms.SecondaryButton}" Click="CancelContract_Click" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconMaterial Kind="Close" Width="22" Height="22" Margin="0,0,8,0"/>
                                        <TextBlock Text="إلغاء الأمر"/>
                                    </StackPanel>
                                </dx:SimpleButton>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </mah:Flyout>
        </mah:FlyoutsControl>
    </mah:MetroWindow.Flyouts>
    <Border x:Name="mybo" CornerRadius="18" Background="{StaticResource Workspace.Canvas}" BorderBrush="{StaticResource Workspace.Line}" BorderThickness="1" Margin="6">
        <DockPanel>
            <Border DockPanel.Dock="Top" CornerRadius="17,17,0,0" Background="{StaticResource Workspace.Header}" Padding="22,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" FlowDirection="LeftToRight">
                        <dx:SimpleButton x:Name="btnCancel" Click="Close_Click" Style="{StaticResource Dcms.WindowButton}" ToolTip="إغلاق" AutomationProperties.Name="إغلاق نافذة العقود">
                            <icons:PackIconMaterial Kind="Close" Width="22" Height="22"/>
                        </dx:SimpleButton>
                       
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <icons:PackIconMaterial Kind="FileDocumentEditOutline" Width="34" Height="34" Foreground="{StaticResource Maintenance.Flyout.HeaderIcon}" Margin="0,0,14,0"/>
                        <StackPanel>
                            <TextBlock Text="متابعة عقود المقرات المملوكة" FontSize="25" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="حصر المقرات المملوكة · العقود والمستفيدون" Foreground="#D6E2F3" Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- ترتيب المصدر محفوظ: المقر، المدة الاختيارية، المستفيد الاختياري، وأوامر العرض والإدراج والإلغاء. -->
                <Border CornerRadius="14" Background="{StaticResource Workspace.Surface}" BorderBrush="{StaticResource Workspace.Line}" BorderThickness="1" Padding="20" Margin="0,0,0,18">
                    <StackPanel>
                        <!-- صف موحد للعناوين وآخر للخانات؛ أعمدة مستقلة للأيقونات وفواصل متساوية تمنع التداخل عند التحجيم. -->
                        <Grid x:Name="ContractsFilters">
                            <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="48"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="المقر" Style="{StaticResource Contracts.Label}" Margin="0" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="2" x:Name="Date_Check" PreviewKeyUp="Date_Check_PreviewKeyUp" Content="للبحث من تاريخ" Margin="0" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="DateFilter_Click"/>
                            <TextBlock Grid.Column="4" Text="إلى تاريخ" Style="{StaticResource Contracts.Label}" Margin="0" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="6" x:Name="by_metar" PreviewKeyUp="by_metar_PreviewKeyUp" Content="بالمستفيد" Margin="0" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="BeneficiaryFilter_Click"/>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Contracts.Field}" Height="48" >
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <icons:PackIconMaterial Kind="OfficeBuildingOutline" Style="{StaticResource Contracts.Icon}" Margin="0" HorizontalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="Combo_Locaton"
                                              ItemsSource="{Binding T_Inventory_Locations}"
                                              DisplayMemberPath="In_Location" SelectedValuePath="In_Location_ID" 
                                              Style="{StaticResource Contracts.Combo}" HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" mah:TextBoxHelper.Watermark="اختر المقر" 
                                              AutomationProperties.Name="اختر المقر"
                                              PreviewKeyUp="Combo_Locaton_PreviewKeyUp" SelectionChanged="Combo_Locaton_SelectionChanged">
                                        <ComboBox.Tag>
                                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="Tag" Mode="TwoWay" UpdateSourceTrigger="Explicit" NotifyOnValidationError="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" ValidatesOnNotifyDataErrors="True">
                                                <Binding.ValidationRules>
                                                    <conv:ErrorRule />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </ComboBox.Tag>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Contracts.Field}" Height="48" IsEnabled="{Binding IsChecked, ElementName=Date_Check}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <icons:PackIconMaterial Kind="CalendarStart" Style="{StaticResource Contracts.Icon}" Margin="0" HorizontalAlignment="Center"/>
                                    <DatePicker Grid.Column="1"
                                               PreviewTextInput="date_br_begin_PreviewTextInput"
                                               SelectedDateChanged="date_br_begin_SelectedDateChanged" x:Name="date_br_begin" Style="{StaticResource Contracts.Date}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="البحث من تاريخ">
                                        <DatePicker.Tag>
                                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="Tag" Mode="TwoWay" UpdateSourceTrigger="Explicit" NotifyOnValidationError="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" ValidatesOnNotifyDataErrors="True">
                                                <Binding.ValidationRules>
                                                    <conv:ErrorRule />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </DatePicker.Tag>
                                    </DatePicker>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource Contracts.Field}" Height="48" IsEnabled="{Binding IsChecked, ElementName=Date_Check}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <icons:PackIconMaterial Kind="CalendarEnd" Style="{StaticResource Contracts.Icon}" Margin="0" HorizontalAlignment="Center"/>
                                    <DatePicker Grid.Column="1"
                                               PreviewTextInput="date_br_end_PreviewTextInput"
                                               SelectedDateChanged="date_br_end_SelectedDateChanged"
                                                x:Name="date_br_end" Style="{StaticResource Contracts.Date}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="البحث إلى تاريخ">
                                        <DatePicker.Tag>
                                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="Tag" Mode="TwoWay" UpdateSourceTrigger="Explicit" NotifyOnValidationError="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" ValidatesOnNotifyDataErrors="True">
                                                <Binding.ValidationRules>
                                                    <conv:ErrorRule />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </DatePicker.Tag>
                                   
                                    </DatePicker>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="6" Style="{StaticResource Contracts.Field}" Height="48" IsEnabled="{Binding IsChecked, ElementName=by_metar}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <icons:PackIconMaterial Kind="AccountOutline" Style="{StaticResource Contracts.Icon}" Margin="0" HorizontalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="Combo_benef" ItemsSource="{Binding T_Benef}" DisplayMemberPath="Benef" SelectedValuePath="Benef_ID" Style="{StaticResource Contracts.Combo}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" mah:TextBoxHelper.Watermark="اختر المستفيد" AutomationProperties.Name="اختر المستفيد">
                                        <ComboBox.Tag>
                                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="Tag" Mode="TwoWay" UpdateSourceTrigger="Explicit" NotifyOnValidationError="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" ValidatesOnNotifyDataErrors="True">
                                                <Binding.ValidationRules>
                                                    <conv:ErrorRule />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </ComboBox.Tag>
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <dx:SimpleButton x:Name="Search_Button" Width="148" Height="48" Style="{StaticResource Dcms.PrimaryButton}" Click="Search_Button_Click">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconMaterial Kind="Magnify" Width="22" Height="22" Margin="0,0,8,0"/>
                                    <TextBlock Text="عرض"/>
                                </StackPanel>
                            </dx:SimpleButton>
                            <dx:SimpleButton x:Name="Insert" Width="148" Height="48" Style="{StaticResource Dcms.PrimaryButton}" Click="NewContract_Click" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconMaterial Kind="PlusBoxMultiple" Width="22" Height="22" Margin="0,0,8,0"/>
                                    <TextBlock Text="إدراج جديد"/>
                                </StackPanel>
                            </dx:SimpleButton>
                            <dx:SimpleButton x:Name="But_Cancl" Width="148" Height="48" Style="{StaticResource Dcms.SecondaryButton}" Click="ClearFilters_Click" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconMaterial Kind="CloseCircleOutline" Width="22" Height="22" Margin="0,0,8,0"/>
                                    <TextBlock Text="إلغاء الأمر"/>
                                </StackPanel>
                            </dx:SimpleButton>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" CornerRadius="14" Background="{StaticResource Workspace.Surface}" BorderBrush="{StaticResource Workspace.Line}" BorderThickness="1" Padding="14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,14">
                            <icons:PackIconMaterial Kind="FileDocumentMultipleOutline" Style="{StaticResource Contracts.Icon}"/>
                            <TextBlock Text="سجل العقود" Foreground="{StaticResource Workspace.Ink}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Grid>
                            <!-- أعمدة المصدر ومساراتها نفسها، بجدول DevExpress ومحاذاة وسطية للرؤوس والخلايا. -->
                            <!-- يبقى مصدر العرض الفوري من ViewModel هو المسؤول عن الاستعلام حسب الفلاتر المعتمدة. -->
                            <dxg:GridControl MouseDoubleClick="Benef_List_MouseDoubleClick" x:Name="Benef_List" RestoreStateKeyFieldName="ID" RestoreStateOnSourceChange="True" dx:ThemeManager.ThemeName="Win11Light" Margin="2,0,0,10" AllowColumnMRUFilterList="False" AllowMRUFilterList="False" IsFilterEnabled="False" ShowAllTableValuesInCheckedFilterPopup="False" SelectionMode="Row" DesignTimeDataSourceRowCount="0" ItemsSource="{Binding ItemsSource, Mode=OneWay}">
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="View" DataSourceRefreshCommand="{Binding DataSourceRefreshCommand}" ShowFixedTotalSummary="False" AllowHeaderNavigation="True" AllowEditing="False" ShowSearchPanelMode="Never" HeaderHorizontalAlignment="Center" RowMinHeight="30" AllowGroupingSortingBySingleColumnOnly="False" AllowMoveColumnToDropArea="False" AllowFixedGroups="False" ShowGroupPanel="False" ShowIndicator="False" AutoWidth="False" FontWeight="Bold" HeaderPanelMinHeight="30" BestFitModeOnSourceChange="AllRows" AllowBestFit="True" BestFitMode="AllRows" AllowPerPixelScrolling="True" ScrollAnimationMode="EaseInOut" VerticalScrollbarVisibility="Auto"  />
                                </dxg:GridControl.View>
                                <dxmvvm:Interaction.Behaviors>
                                    <dxg:DialogEditFormBehavior x:Name="EditFormBehavior" KeyProperty="ID" CreateEditItemViewModelCommand="{Binding CreateEditEntityViewModelCommand}" ValidateRowCommand="{Binding ValidateRowCommand}" ValidateRowDeletionCommand="{Binding ValidateRowDeletionCommand}" />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.InputBindings>
                                    <KeyBinding Key="Delete" Command="{Binding DeleteCommand, ElementName=EditFormBehavior}" />
                                    <KeyBinding Key="F2" Command="{Binding UpdateCommand, ElementName=EditFormBehavior}" />
                                    <KeyBinding Key="N" Command="{Binding CreateCommand, ElementName=EditFormBehavior}" Modifiers="Control" />
                                </dxg:GridControl.InputBindings>
                                <dxg:GridColumn IsSmart="True" FieldName="Cont_data" AllowGrouping="False" AllowMoving="False" HorizontalHeaderContentAlignment="Center" Width="650" Header="بــــــــيــــــــــــــــــان الـــــــــــعـــــقـــــــــد" FixedWidth="True" MaxWidth="650">
                                    <dxg:GridColumn.HeaderStyle>
                                        <Style TargetType="{x:Type dxg:BaseGridHeader}">
                                            <Setter Property="dxg:BaseGridColumnHeader.ShowFilterButtonOnHover" Value="False" />
                                            <Setter Property="Background" Value="#213F6A" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Style>
                                    </dxg:GridColumn.HeaderStyle>
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:TextEdit x:Name="PART_Editor" TextWrapping="WrapWithOverflow" HorizontalContentAlignment="Center" FontSize="14" Style="{StaticResource Dmc.GridCellText}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
