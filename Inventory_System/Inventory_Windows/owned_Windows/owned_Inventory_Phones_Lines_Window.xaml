                  <dx:SimpleButton x:Name="CancelLine" Click="CancelDraft_Click" Style="{StaticResource Dcms.PrimaryButton}" Margin="5" MinWidth="122">
                    <StackPanel Orientation="Horizontal">
                      <icons:PackIconMaterial Kind="CloseCircleOutline" Width="20" Height="20" Margin="0,0,8,0" />
                      <TextBlock Text="إلغاء" />
                    </StackPanel>
                  </dx:SimpleButton>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </mah:Flyout>
      <mah:Flyout x:Name="PrintFlyout" Style="{StaticResource Maintenance.Flyout}" IsOpenChanged="PrintFlyout_Changed">
        <Border Style="{StaticResource Maintenance.Flyout.Card}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource Workspace.Header}" CornerRadius="17,17,0,0" Padding="18,14">
              <DockPanel>
                <dx:SimpleButton Click="ClosePrint_Click" DockPanel.Dock="Right" Style="{StaticResource Dcms.WindowButton}" ToolTip="إغلاق">
                  <icons:PackIconMaterial Kind="Close" Width="22" Height="22" />
                </dx:SimpleButton>
                <StackPanel Orientation="Horizontal">
                  <icons:PackIconMaterial Kind="PhoneInTalkOutline" Foreground="#EACD8C" Width="28" Height="28" Margin="0,0,12,0" />
