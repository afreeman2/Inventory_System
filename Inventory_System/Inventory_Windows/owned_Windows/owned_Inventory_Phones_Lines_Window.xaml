  <Border Style="{StaticResource Dmc.WindowCard}" CornerRadius="18" Margin="12" Background="White" BorderBrush="{StaticResource Dmc.Border}" BorderThickness="1">
    <DockPanel Margin="8">
      <Border DockPanel.Dock="Top" Background="{StaticResource Workspace.Header}" CornerRadius="17,17,0,0" Padding="18,14">
        <DockPanel>
          <dx:SimpleButton Click="Close_Click" DockPanel.Dock="Right" Style="{StaticResource Dcms.WindowButton}" ToolTip="إغلاق">
            <icons:PackIconMaterial Kind="Close" Width="22" Height="22" />
          </dx:SimpleButton>
          <StackPanel Orientation="Horizontal">
            <icons:PackIconMaterial Kind="PhoneInTalkOutline" Foreground="#EACD8C" Width="28" Height="28" Margin="0,0,12,0" />
            <StackPanel>
              <TextBlock Text="خطوط الهاتف للمقرات المملوكة" FontSize="25" FontWeight="SemiBold" Foreground="White" />
              <TextBlock Text="توزيع أرقام الهواتف على الإدارات والأقسام والوحدات" Foreground="#DAE4F4" Margin="0,4,0,0" />
