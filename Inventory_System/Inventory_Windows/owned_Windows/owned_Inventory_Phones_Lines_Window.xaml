  <mah:MetroWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" x:Class="Inventory_System.Inventory_Windows.owned_Windows.owned_Inventory_Phones_Lines_Window" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys" xmlns:dxp="http://schemas.devexpress.com/winfx/2008/xaml/printing" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:conv="clr-namespace:Inventory_System.converts" xmlns:vm="clr-namespace:Inventory_System.viewo_Model" xmlns:sys="clr-namespace:System;assembly=mscorlib" Title="خطوط الهاتف للمقرات المملوكة" Width="1920" Height="1080" MinWidth="960" MinHeight="700" WindowState="Maximized" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowTitleBar="False" ShowCloseButton="False" ShowMinButton="False" ShowMaxRestoreButton="False" WindowStyle="None" AllowsTransparency="True" Background="Transparent" BorderThickness="0" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="15" UseLayoutRounding="True" SnapsToDevicePixels="True" dx:ThemeManager.ThemeName="Win11Light" vm:RoundedWindowFrame.Enabled="True" Loaded="Window_Loaded" PreviewKeyDown="Window_KeyDown">
