                <icons:PackIconMaterial Kind="OfficeBuildingOutline" Style="{StaticResource Lookup.NameIcon}" />
                <ComboBox x:Name="FilterBuilding" AutomationProperties.Name="المقر" Style="{StaticResource Line.Combo}" DisplayMemberPath="In_Location" SelectedValuePath="In_Location_ID" SelectionChanged="Filter_Changed" />
              </DockPanel>
            </Border>
          </StackPanel>
          <StackPanel Margin="6,8">
            <TextBlock Text="بحث برقم الهاتف" Style="{StaticResource Line.Label}" />
            <Border Style="{StaticResource Lookup.NameField}">
              <DockPanel>
                <icons:PackIconMaterial Kind="PhoneOutline" Style="{StaticResource Lookup.NameIcon}" />
                <TextBox IsEnabled="False" x:Name="PhoneSearch" AutomationProperties.Name="بحث برقم الهاتف" Style="{StaticResource Lookup.NameText}" MaxLength="50" TextChanged="PhoneSearch_Changed" FlowDirection="LeftToRight" />
