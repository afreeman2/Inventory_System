        <TextBlock Text="صندوق الضمان الاجتماعي" dxp:ExportSettings.TargetType="Text" dxp:TextExportSettings.FontSize="18" dxp:TextExportSettings.FontFamily="Segoe UI" dxp:TextExportSettings.HorizontalAlignment="Center" dxp:TextExportSettings.Text="{Binding Text, RelativeSource={RelativeSource Self}}" TextAlignment="Center" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="{Binding}" dxp:ExportSettings.TargetType="Text" dxp:TextExportSettings.FontSize="18" dxp:TextExportSettings.FontFamily="Segoe UI" dxp:TextExportSettings.HorizontalAlignment="Center" dxp:TextExportSettings.Text="{Binding}" TextAlignment="Center" FontSize="16" Margin="0,6,0,0" />
      </StackPanel>
