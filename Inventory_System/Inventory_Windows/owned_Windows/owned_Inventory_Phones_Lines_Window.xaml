                        </DockPanel>
                      </Border>
                      <dx:SimpleButton x:Name="ManageOrganizations" Click="ManageOrganizations_Click" Style="{StaticResource Dcms.PrimaryButton}" Margin="8,0,0,0" MinWidth="46" Grid.Column="1" Width="46" Height="46" Padding="0" ToolTip="الإدارات والأقسام" AutomationProperties.Name="الإدارات والأقسام">
                        <StackPanel Orientation="Horizontal">
                          <icons:PackIconMaterial Kind="Plus" Width="20" Height="20" Margin="0" />
                        </StackPanel>
                      </dx:SimpleButton>
                    </Grid>
                  </StackPanel>
                  <StackPanel Margin="6,8">
                    <TextBlock Text="القسم أو الوحدة" Style="{StaticResource Line.Label}" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Style="{StaticResource Lookup.NameField}">
                        <DockPanel>
                          <icons:PackIconMaterial Kind="FileTree" Style="{StaticResource Lookup.NameIcon}" />
                          <ComboBox x:Name="DraftSection" AutomationProperties.Name="القسم أو الوحدة" Style="{StaticResource Line.Combo}" DisplayMemberPath="Secti" SelectedValuePath="Secti_ID" />
                        </DockPanel>
                      </Border>
                      <dx:SimpleButton x:Name="ManageSections" Click="ManageSections_Click" Style="{StaticResource Dcms.PrimaryButton}" Margin="8,0,0,0" MinWidth="46" Grid.Column="1" Width="46" Height="46" Padding="0" ToolTip="الأقسام والوحدات" AutomationProperties.Name="الأقسام والوحدات">
                        <StackPanel Orientation="Horizontal">
                          <icons:PackIconMaterial Kind="Plus" Width="20" Height="20" Margin="0" />
