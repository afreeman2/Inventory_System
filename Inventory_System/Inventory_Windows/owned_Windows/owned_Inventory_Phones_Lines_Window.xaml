              <icons:PackIconMaterial Kind="CloseCircleOutline" Width="20" Height="20" Margin="0,0,8,0" />
              <TextBlock Text="إلغاء الأمر" />
            </StackPanel>
          </dx:SimpleButton>
          <dx:SimpleButton x:Name="ClearFilters" Click="ClearFilters_Click" Style="{StaticResource Dcms.PrimaryButton}" Margin="5" MinWidth="122">
