        <Border Style="{StaticResource Maintenance.Flyout.Card}" Width="920" MaxWidth="1120" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource Workspace.Header}" CornerRadius="17,17,0,0" Padding="18,14">
              <DockPanel>
                <dx:SimpleButton Click="CancelReport_Click" DockPanel.Dock="Right" Style="{StaticResource Dcms.WindowButton}" ToolTip="إغلاق">
                  <icons:PackIconMaterial Kind="Close" Width="22" Height="22" />
                </dx:SimpleButton>
                <StackPanel Orientation="Horizontal">
                  <icons:PackIconMaterial Kind="FileDocumentOutline" Foreground="#EACD8C" Width="28" Height="28" Margin="0,0,12,0" />
                  <TextBlock Text="تقارير حصر الهواتف" Foreground="White" FontSize="22" />
                </StackPanel>
              </DockPanel>
            </Border>
            <StackPanel Margin="22,18">
              <TextBlock Text="عنوان التقرير" Style="{StaticResource Line.Label}" />
              <Border Style="{StaticResource Lookup.NameField}" Margin="0,0,0,16">
                <DockPanel>
                  <icons:PackIconMaterial Kind="FormatTitle" Style="{StaticResource Lookup.NameIcon}" />
                  <TextBox x:Name="ReportTitle" AutomationProperties.Name="عنوان التقرير" Style="{StaticResource Lookup.NameText}" MaxLength="120" Text="تقارير حصر الهواتف" />
                </DockPanel>
              </Border>
              <UniformGrid Columns="2" Margin="0,0,0,8">
                <StackPanel Margin="6,8">
                  <TextBlock Text="المقر" Style="{StaticResource Line.Label}" />
                  <Border Style="{StaticResource Lookup.NameField}" MinHeight="60">
                    <DockPanel>
                      <icons:PackIconMaterial Kind="OfficeBuildingOutline" Style="{StaticResource Lookup.NameIcon}" />
                      <ComboBox x:Name="ReportBuilding" AutomationProperties.Name="مقر التقرير" Style="{StaticResource Line.Combo}" MinHeight="58" FontSize="17" DisplayMemberPath="In_Location" SelectedValuePath="In_Location_ID" />
                    </DockPanel>
                  </Border>
                </StackPanel>
                <StackPanel Margin="6,8">
                  <CheckBox x:Name="ReportByManagement" Content="حسب الإدارة" Click="ReportManagementFilter_Click" Margin="0,0,0,7" />
                  <Border Style="{StaticResource Lookup.NameField}" MinHeight="60">
                    <DockPanel>
                      <icons:PackIconMaterial Kind="Domain" Style="{StaticResource Lookup.NameIcon}" />
                      <ComboBox x:Name="ReportManagement" AutomationProperties.Name="إدارة التقرير" IsEnabled="False" Style="{StaticResource Line.Combo}" MinHeight="58" FontSize="17" DisplayMemberPath="Manag" SelectedValuePath="Manag_ID" />
                    </DockPanel>
                  </Border>
                </StackPanel>
              </UniformGrid>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,0">
                <dx:SimpleButton Click="PrintReport_Click" Style="{StaticResource Dcms.PrimaryButton}" Margin="5" MinWidth="142">
                  <StackPanel Orientation="Horizontal">
                    <icons:PackIconMaterial Kind="PrinterOutline" Width="20" Height="20" Margin="0,0,8,0" />
                    <TextBlock Text="طباعة التقرير" />
                  </StackPanel>
                </dx:SimpleButton>
                <dx:SimpleButton Click="CancelReport_Click" Style="{StaticResource Dcms.PrimaryButton}" Margin="5" MinWidth="142">
                  <StackPanel Orientation="Horizontal">
                    <icons:PackIconMaterial Kind="CloseCircleOutline" Width="20" Height="20" Margin="0,0,8,0" />
                    <TextBlock Text="إلغاء الأمر" />
                  </StackPanel>
                </dx:SimpleButton>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>
      </mah:Flyout>
