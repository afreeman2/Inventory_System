            <dxg:GridColumn.EditSettings>
              <dxe:TextEditSettings HorizontalContentAlignment="Center" />
            </dxg:GridColumn.EditSettings>
            <dxg:GridColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <icons:PackIconMaterial Kind="Domain" Width="19" Height="19" Foreground="#526C99" Margin="0,0,8,0" />
                  <dxe:TextEdit x:Name="PART_Editor" HorizontalContentAlignment="Center" Style="{StaticResource Dmc.GridCellText}" />
