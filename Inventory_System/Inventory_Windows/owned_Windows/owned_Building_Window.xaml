<mah:MetroWindow
    x:Class="Inventory_System.Inventory_Windows.owned_Windows.owned_Building_Window"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:vm="clr-namespace:Inventory_System.converts"
    xmlns:local2="clr-namespace:Inventory_System.viewo_Model"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    DataContext="{dxmvvm:ViewModelSource Type=local2:owned_building_viewmodel}"
    Title="إدارة المباني" Width="1000" Height="1000" MinWidth="780" MinHeight="560"
    WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
    AllowsTransparency="True" Background="Transparent" BorderThickness="0" GlowBrush="{x:Null}"
    ShowTitleBar="False" ShowCloseButton="False" IsCloseButtonEnabled="False"
    local2:RoundedWindowFrame.Enabled="True" dx:ThemeManager.ThemeName="Win11Light"
     ShowMinButton="False" ShowMaxRestoreButton="False" 
    Icon="{iconPacks:MaterialImage Kind=OfficeBuilding}" FontFamily="Segoe UI" FontSize="14"
    FlowDirection="RightToLeft" Loaded="MetroWindow_Loaded" PreviewKeyDown="BuildingWindow_PreviewKeyDown"
    UseLayoutRounding="True" SnapsToDevicePixels="True"  >
    <mah:MetroWindow.Resources>
        <vm:InputHasValueConverter x:Key="Building.HasValue"/>

        <!-- حدود الخانة تعكس التحويم والتركيز والقيمة الفعلية، بما يشمل خانة البحث المرتبطة بالجدول. -->
        <Style x:Key="Building.Field" TargetType="Border">
            <Setter Property="vm:FieldFeedback.IsFieldSurface" Value="True"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource Workspace.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8FAFD"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5FB"/>
                    <Setter Property="BorderBrush" Value="#A5B7D2"/>
                </Trigger>
                <Trigger Property="local2:InputFieldState.HasValue" Value="True">
                    <Setter Property="Background" Value="#E2EAF6"/>
                    <Setter Property="BorderBrush" Value="#A7BAD7"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#EDF3FD"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Workspace.Primary}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                        <Condition Property="local2:InputFieldState.HasValue" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#D8E5F7"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Building.InputIcon" TargetType="iconPacks:PackIconMaterial">
            <Setter Property="Width" Value="21"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Workspace.Primary}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="Building.Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Workspace.Ink}"/>
        </Style>
        <Style x:Key="Building.Text" TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Workspace.Ink}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="mah:TextBoxHelper.ClearTextButton" Value="True"/>
            <Setter Property="vm:FieldFeedback.Enabled" Value="True"/>
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Validation.FieldError}"/>
        </Style>
        <Style x:Key="ArabicGridSearchControlStyle" TargetType="dxg:GridSearchControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ShowEditorBorder" Value="False"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Workspace.Ink}"/>
            <Setter Property="NullText" Value="أدخل اسم المبنى"/>
            <Setter Property="ShowNullTextIfFocused" Value="True"/>
            <Setter Property="vm:FieldFeedback.Enabled" Value="True"/>
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Validation.FieldError}"/>
        </Style>

        <!-- تنسيق الجدول محلي مع الاحتفاظ بأوامر الحذف والتحديث واختصاراتها. -->
        <Style TargetType="local2:AccessibleGridControl" BasedOn="{StaticResource {x:Type dxg:GridControl}}"/>
        <Style x:Key="Building.ColumnHeader" TargetType="dxg:GridColumnHeader" BasedOn="{StaticResource Modern.GridHeader}">
            <Setter Property="Background" Value="{StaticResource Workspace.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Building.RowText" TargetType="dxe:TextEdit" BasedOn="{StaticResource Dmc.GridCellText}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MaxWidth" Value="350"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <DataTemplate x:Key="ButtonCellTemplate">
            <dx:SimpleButton Command="{Binding DeleteCommand, ElementName=EditFormBehavior}" CommandParameter="{Binding Row}"
                             Style="{StaticResource Dcms.DangerButton}" Width="36" Height="32" MinHeight="32" Padding="0"
                             HorizontalAlignment="Center" VerticalAlignment="Center" 
AutomationProperties.Name="{Binding RowData.Row.Name, StringFormat='حذف {0}'}">
                <dx:SimpleButton.ToolTip>
                    <ToolTip>
                        <TextBlock
                FlowDirection="RightToLeft"
                Text="{Binding RowData.Row.Name, StringFormat='حذف {0}'}"/>
                    </ToolTip>
                </dx:SimpleButton.ToolTip>
                <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="18" Height="18"/>
            </dx:SimpleButton>
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl>
            <!-- لوحة تعديل مستقلة مصممة في XAML، وحقولها تحتفظ بأحداثها والتحقق الأصلي. -->
            <mah:Flyout x:Name="config_Nationalty" Style="{StaticResource Maintenance.Flyout}"
                        IsOpenChanged="BuildingEdit_IsOpenChanged">
                <!-- تتوسط بطاقة التعديل النافذة أفقيًا وعموديًا دون إزاحة علوية ثابتة. -->
                <Border Style="{StaticResource Maintenance.Flyout.Card}" Width="560"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource Workspace.Header}" CornerRadius="17,17,0,0" Padding="18,12">
                            <DockPanel>
                                <Button x:Name="closeconfig" DockPanel.Dock="Right" Click="closeconfig_Click"
                                        Style="{StaticResource Dmc.SecondaryButton}" Background="#32DF6363" Foreground="White"
                                        Width="36" Height="36" Padding="0" ToolTip="إغلاق التعديل" AutomationProperties.Name="إغلاق التعديل">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="20" Height="20"/>
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="PencilOutline" Width="25" Height="25"
                                                               Foreground="{StaticResource Maintenance.Flyout.HeaderIcon}" Margin="0,0,10,0"/>
                                    <TextBlock Text="تعديل بيانات المبنى" Foreground="White" FontWeight="SemiBold" FontSize="20"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel Margin="20">
                            <TextBlock Text="اسم المبنى" Style="{StaticResource Building.Label}"/>
                            <Border x:Name="TxtName_updateField" Style="{StaticResource Building.Field}"
        local2:InputFieldState.HasValue="{Binding Text, ElementName=TxtName_update, Converter={StaticResource Building.HasValue}}">
                                <DockPanel Margin="10,0,6,0">
                                    <iconPacks:PackIconMaterial Kind="OfficeBuildingOutline" DockPanel.Dock="Left" Style="{StaticResource Building.InputIcon}"/>
                                    <TextBox x:Name="TxtName_update" Style="{StaticResource Building.Text}" MaxLength="150"
                 PreviewKeyUp="TxtName_update_PreviewKeyUp" TextChanged="TxtName_update_TextChanged"
                 mah:TextBoxHelper.Watermark="أدخل اسم المبنى" AutomationProperties.Name="أدخل اسم المبنى">
                                        <TextBox.Tag>
                                            <Binding RelativeSource="{RelativeSource Self}" Path="Tag" Mode="TwoWay" UpdateSourceTrigger="Explicit"
             NotifyOnValidationError="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" ValidatesOnNotifyDataErrors="True">
                                                <Binding.ValidationRules>
                                                    <vm:ErrorRule/>
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Tag>
                                    </TextBox>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="العنوان" Style="{StaticResource Building.Label}" Margin="0,16,0,7"/>
                            <Border x:Name="Txtadress_updateField" Style="{StaticResource Building.Field}"
        local2:InputFieldState.HasValue="{Binding Text, ElementName=Txtadress_update, Converter={StaticResource Building.HasValue}}">
                                <DockPanel Margin="10,0,6,0">
                                    <iconPacks:PackIconMaterial Kind="MapMarkerOutline" DockPanel.Dock="Left" Style="{StaticResource Building.InputIcon}"/>
                                    <TextBox x:Name="Txtadress_update" Style="{StaticResource Building.Text}" MaxLength="150"
                 PreviewKeyUp="Txtadress_update_PreviewKeyUp" TextChanged="Txtadress_update_TextChanged"
                 mah:TextBoxHelper.Watermark="أدخل العنوان" AutomationProperties.Name="أدخل العنوان">
                                        <TextBox.Tag>
                                            <Binding RelativeSource="{RelativeSource Self}" Path="Tag" Mode="TwoWay" UpdateSourceTrigger="Explicit"
             NotifyOnValidationError="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" ValidatesOnNotifyDataErrors="True">
                                                <Binding.ValidationRules>
                                                    <vm:ErrorRule/>
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Tag>
                                    </TextBox>
                                </DockPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,22,0,0">
                                <Button x:Name="update_button" Click="update_button_ClickAsync" Style="{StaticResource Dmc.PrimaryButton}"
                                        Background="{StaticResource Workspace.Primary}" Padding="18,0" TabIndex="23">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="حفظ التعديل" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="cancel_button" Click="closeconfig_Click" Style="{StaticResource Dmc.SecondaryButton}"
                                        Background="{StaticResource Workspace.Tint}" Foreground="{StaticResource Workspace.Primary}" Margin="8,0,0,0" TabIndex="24">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Close" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="إلغاء" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </mah:Flyout>
        </mah:FlyoutsControl>
    </mah:MetroWindow.Flyouts>

    <Border x:Name="mybo" Background="{StaticResource Workspace.Canvas}" BorderBrush="{StaticResource Workspace.Line}"
            BorderThickness="1" CornerRadius="18" Margin="6" local2:RoundedSurface.Radius="18">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource Workspace.Header}" CornerRadius="17,17,0,0" Padding="20,13">
                <DockPanel>
                    <Button x:Name="btnCancel" DockPanel.Dock="Right" Click="btnCancel_Click" Style="{StaticResource Dmc.SecondaryButton}"
                            Width="36" Height="36" Padding="0" Background="#32DF6363" Foreground="White"
                            ToolTip="إغلاق النافذة" AutomationProperties.Name="إغلاق النافذة">
                        <iconPacks:PackIconMaterial Kind="Close" Width="20" Height="20"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="OfficeBuildingOutline" Width="29" Height="29"
                                                   Foreground="{StaticResource Maintenance.Flyout.HeaderIcon}" Margin="0,0,12,0"/>
                        <TextBlock Text="إدارة المباني" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Workspace.Line}" BorderThickness="0,0,0,1" Padding="20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="اسم المبنى" Style="{StaticResource Building.Label}"/>
                            <Border x:Name="BuildingNameField" Style="{StaticResource Building.Field}"
                                    local2:InputFieldState.HasValue="{Binding SearchText, ElementName=TxtName, Converter={StaticResource Building.HasValue}}">
                                <DockPanel Width="462">
                                    <iconPacks:PackIconMaterial Kind="OfficeBuildingOutline" DockPanel.Dock="Left" Style="{StaticResource Building.InputIcon}"/>
                                    <dxg:GridSearchControl x:Name="TxtName" Style="{StaticResource ArabicGridSearchControlStyle}"
                                                           View="{Binding ElementName=View, Mode=OneTime}" ShowNullTextIfFocused="True"
                                                           DataObject.Pasting="TxtName_Pasting" Loaded="TxtName_Loaded" PreviewTextInput="TxtName_PreviewTextInput"
                                                           PreviewKeyUp="TxtName_PreviewKeyUp" TabIndex="1"
                                                           AutomationProperties.Name="اسم المبنى" Width="462" Margin="-31,1,12,12">
                                        <dxg:GridSearchControl.Tag>
                                            <Binding RelativeSource="{RelativeSource Self}" Path="Tag" Mode="TwoWay" UpdateSourceTrigger="Explicit"
             NotifyOnValidationError="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" ValidatesOnNotifyDataErrors="True">
                                                <Binding.ValidationRules>
                                                    <vm:ErrorRule/>
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </dxg:GridSearchControl.Tag>
                                    </dxg:GridSearchControl>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="العنوان" Style="{StaticResource Building.Label}"/>
                            <Border x:Name="TxtaddressField" Style="{StaticResource Building.Field}"
        local2:InputFieldState.HasValue="{Binding Text, ElementName=Txtaddress, Converter={StaticResource Building.HasValue}}">
                                <DockPanel Width="463">
                                    <iconPacks:PackIconMaterial Kind="MapMarkerOutline" DockPanel.Dock="Left" Style="{StaticResource Building.InputIcon}"/>
                                    <TextBox x:Name="Txtaddress" Style="{StaticResource Building.Text}" MaxLength="150"
                 PreviewKeyUp="Txtaddress_PreviewKeyUp" TextChanged="Txtaddress_TextChanged"
                 mah:TextBoxHelper.Watermark="أدخل العنوان" AutomationProperties.Name="أدخل العنوان">
                                        <TextBox.Tag>
                                            <Binding RelativeSource="{RelativeSource Self}" Path="Tag" Mode="TwoWay" UpdateSourceTrigger="Explicit"
             NotifyOnValidationError="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" ValidatesOnNotifyDataErrors="True">
                                                <Binding.ValidationRules>
                                                    <vm:ErrorRule/>
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Tag>
                                    </TextBox>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,0">
                        <Button x:Name="insert" Click="insert_Click" Style="{StaticResource Dmc.PrimaryButton}" Background="{StaticResource Workspace.Primary}"
                                MinWidth="126" TabIndex="3">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="حفظ" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="cancel" Click="btnCancel_Click" Style="{StaticResource Dmc.SecondaryButton}"
                                Background="{StaticResource Workspace.Tint}" Foreground="{StaticResource Workspace.Primary}" Margin="8,0,0,0" MinWidth="126" TabIndex="4">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CloseCircleOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="إلغاء الأمر" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource Workspace.Line}" BorderThickness="1" CornerRadius="12" Padding="1" Margin="18">
                <!-- تبقى بيانات كل عمود ومحرره وأوامره كما هي، وتعرض الأيقونة بجانب القيمة في الوسط. -->
                <local2:AccessibleGridControl x:Name="Benef_List" MouseDoubleClick="Benef_List_MouseDoubleClick"
                    RestoreStateKeyFieldName="In_Location_ID" RestoreStateOnSourceChange="True"
                    AllowColumnMRUFilterList="False" AllowMRUFilterList="False" IsFilterEnabled="False"
                    ShowAllTableValuesInCheckedFilterPopup="False" SelectionMode="Row" AutoGenerateColumns="None"
                    BorderThickness="0" ItemsSource="{Binding ItemsSource, Mode=OneWay}">
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="View" DataSourceRefreshCommand="{Binding DataSourceRefreshCommand}"
                            ColumnHeaderStyle="{StaticResource Building.ColumnHeader}" RowMinHeight="48" HeaderPanelMinHeight="44"
                            AlternateRowBackground="#F5F8FC" ShowHorizontalLines="True" ShowVerticalLines="False"
                            ShowFixedTotalSummary="False" AllowHeaderNavigation="True" AllowEditing="False"
                            ShowSearchPanelMode="Never" HeaderHorizontalAlignment="Center"
                            AllowGroupingSortingBySingleColumnOnly="False" AllowMoveColumnToDropArea="False" AllowFixedGroups="False"
                            ShowGroupPanel="False" ShowIndicator="False" AutoWidth="True"
                            AllowBestFit="True" AllowPerPixelScrolling="True" ScrollAnimationMode="EaseInOut"
                            VerticalScrollbarVisibility="Auto" SearchStringToFilterCriteria="View_SearchStringToFilterCriteria"
                            SearchPanelFindFilter="StartsWith"/>
                    </dxg:GridControl.View>
                    <dxmvvm:Interaction.Behaviors>
                        <dxg:DialogEditFormBehavior x:Name="EditFormBehavior" KeyProperty="In_Location_ID"
                            CreateEditItemViewModelCommand="{Binding CreateEditEntityViewModelCommand}"
                            ValidateRowCommand="{Binding ValidateRowCommand}" ValidateRowDeletionCommand="{Binding ValidateRowDeletionCommand}"/>
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding DeleteCommand, ElementName=EditFormBehavior}"/>
                        <KeyBinding Key="F2" Command="{Binding UpdateCommand, ElementName=EditFormBehavior}"/>
                        <KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateCommand, ElementName=EditFormBehavior}"/>
                    </dxg:GridControl.InputBindings>
                    <dxg:GridColumn IsSmart="True" FieldName="In_Location" Header="المباني" Width="2*" AllowGrouping="False" AllowMoving="False" HorizontalHeaderContentAlignment="Center">
                        <dxg:GridColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="OfficeBuildingOutline" Width="17" Height="17" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="المباني" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </dxg:GridColumn.HeaderTemplate>
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Kind="OfficeBuildingOutline" Width="18" Height="18" Foreground="{StaticResource Workspace.Primary}"
                                                           Margin="0,0,9,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <dxe:TextEdit x:Name="PART_Editor" Grid.Column="1" Style="{StaticResource Building.RowText}"/>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn IsSmart="True" FieldName="Address" Header="العنوان" Width="2*" AllowGrouping="False" AllowMoving="False" HorizontalHeaderContentAlignment="Center">
                        <dxg:GridColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="MapMarkerOutline" Width="17" Height="17" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="العنوان" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </dxg:GridColumn.HeaderTemplate>
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Kind="MapMarkerOutline" Width="18" Height="18" Foreground="{StaticResource Workspace.Copper}"
                                                           Margin="0,0,9,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <dxe:TextEdit x:Name="PART_Editor" Grid.Column="1" Style="{StaticResource Building.RowText}"/>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn IsSmart="True" Header="حذف" CellTemplate="{StaticResource ButtonCellTemplate}"
                                    HorizontalHeaderContentAlignment="Center" Width="80" FixedWidth="True" AllowSorting="False" AllowColumnFiltering="False"/>
                </local2:AccessibleGridControl>
            </Border>
        </DockPanel>
    </Border>
</mah:MetroWindow>
