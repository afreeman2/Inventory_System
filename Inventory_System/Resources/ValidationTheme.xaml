<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Inventory_System.converts">
    <conv:BooleanOrConverter x:Key="Validation.BooleanOr"/>
        <!-- يظهر التحقق على البورد كاملًا، وتبقى الرسالة في تلميح محدود بعرض الخانة بدل تمديد الواجهة. -->
        <ControlTemplate x:Key="Validation.FieldError">
            <Grid>
                <AdornedElementPlaceholder x:Name="FieldAdorner"/>
                <Border BorderBrush="#D92D20" BorderThickness="2" CornerRadius="10" IsHitTestVisible="False"/>
                <Border x:Name="ErrorBadge" Width="18" Height="18" CornerRadius="9" Background="#D92D20"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0">
                    <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                        <Popup x:Name="ErrorMessage" Placement="Bottom" PlacementTarget="{Binding ElementName=FieldAdorner, Path=AdornedElement}"
                                 DataContext="{Binding ElementName=FieldAdorner, Path=AdornedElement}"
                                 HorizontalOffset="0" VerticalOffset="6"
                                 AllowsTransparency="True" StaysOpen="True" Focusable="False" IsHitTestVisible="False">
                            <Popup.IsOpen>
                                <MultiBinding Mode="OneWay" Converter="{StaticResource Validation.BooleanOr}">
                                    <Binding ElementName="FieldAdorner" Path="AdornedElement.IsKeyboardFocusWithin"/>
                                    <Binding ElementName="FieldAdorner" Path="AdornedElement.IsMouseOver"/>
                                    <Binding ElementName="ErrorBadge" Path="IsMouseOver"/>
                                </MultiBinding>
                            </Popup.IsOpen>
                            <Border Background="#FFF3F2" BorderBrush="#D92D20" BorderThickness="1" CornerRadius="8" Padding="10,7"
                                    MaxWidth="{Binding ActualWidth}" FlowDirection="RightToLeft">
                                <TextBlock
                                           Foreground="#9A221A" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right">
                                    <TextBlock.Text>
                                        <PriorityBinding>
                                            <Binding Path="(Validation.ValidationAdornerSiteFor).(Validation.Errors)[0].ErrorContent"/>
                                            <Binding Path="(Validation.Errors)[0].ErrorContent"/>
                                        </PriorityBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                        </Popup>
            </Grid>
        </ControlTemplate>
</ResourceDictionary>
